<%= form_with model: [:company, @company], url: company_profile_path,
      method: :patch, local: true do |f| %>
  <div class="card" style="max-width:680px;">
    <div class="card-header">
      <h3 style="font-family:var(--font-display);">Informations entreprise</h3>
    </div>
    <div class="card-body">
      <% if @company.errors.any? %>
        <div class="alert alert-error" style="margin-bottom:20px;">
          <% @company.errors.full_messages.each do |msg| %>
            <div>• <%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, "Nom de l'entreprise", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Plomberie Dupont & Fils" %>
      </div>

      <div class="form-group" data-controller="logo-preview">
        <label class="form-label">Logo de l'entreprise</label>
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:10px;">
          <div style="width:72px; height:72px; border-radius:12px; overflow:hidden; border:1px solid var(--border-light);
                      background:var(--gray-50); display:flex; align-items:center; justify-content:center;">
            <%= image_tag (@company.logo_url.presence || ""),
                  alt: "Logo #{@company.name}",
                  data: { logo_preview_target: "image" },
              style: "width:100%; height:100%; object-fit:cover; display:#{@company.logo_url.present? ? 'block' : 'none'};" %>

            <div data-logo-preview-target="placeholder"
                 style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;
                font-size:1.15rem; color:var(--text-400); <%= @company.logo_url.present? ? 'display:none;' : '' %>">
              <%= @company.name.to_s.first&.upcase || "?" %>
            </div>
          </div>

          <div style="display:flex; flex-direction:column; gap:8px; min-width:260px; flex:1;">
            <%= f.file_field :logo,
                  accept: "image/png,image/jpeg,image/webp,image/gif",
                  data: { logo_preview_target: "input", action: "change->logo-preview#preview" },
                  class: "form-control" %>
            <span class="form-hint">Formats acceptes: JPG, PNG, WEBP, GIF (max 5 MB).</span>
            <span class="form-hint">Apercu instantane active: l'image est recadree en carre automatiquement.</span>

            <% if @company.logo_url.present? %>
              <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                <%= f.check_box :remove_logo, { data: { logo_preview_target: "remove", action: "change->logo-preview#toggleRemove" } }, "1", "0" %>
                <span>Supprimer le logo actuel</span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :siret, "SIRET", class: "form-label" %>
        <%= f.text_field :siret, class: "form-control", placeholder: "14 chiffres", maxlength: 14 %>
      </div>

      <div class="form-group">
        <%= f.label :address, "Adresse", class: "form-label" %>
        <%= f.text_field :address, class: "form-control", placeholder: "12 rue des Artisans" %>
      </div>

      <div class="responsive-grid-2-1" style="display:grid; grid-template-columns:2fr 1fr; gap:12px;">
        <div class="form-group">
          <%= f.label :city, "Ville", class: "form-label" %>
          <%= f.text_field :city, class: "form-control", placeholder: "Lyon" %>
        </div>
        <div class="form-group">
          <%= f.label :zip_code, "Code postal", class: "form-label" %>
          <%= f.text_field :zip_code, class: "form-control", placeholder: "69001" %>
        </div>
      </div>

      <div class="responsive-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <div class="form-group">
          <%= f.label :phone, "Téléphone", class: "form-label" %>
          <%= f.phone_field :phone, class: "form-control", placeholder: "04 78 00 00 00" %>
        </div>
        <div class="form-group">
          <%= f.label :website, "Site web (optionnel)", class: "form-label" %>
          <%= f.url_field :website, class: "form-control", placeholder: "https://monsite.fr" %>
        </div>
      </div>

      <div data-controller="dependent_select" data-dependent_select-specialty-url-value="<%= company_profile_specialties_by_category_path %>">
        <div class="form-group">
          <%= f.label :professional_category, "Type d'activite", class: "form-label" %>
          <%= f.select :professional_category,
                [
                  ["Entreprise standard", "standard_business"],
                  ["Professionnel de sante", "healthcare_professional"]
                ],
                {},
                class: "form-control",
                data: {
                  dependent_select_target: "categorySelect",
                  action: "change->dependent_select#categoryChanged"
                } %>
        </div>

        <div class="responsive-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <div class="form-group">
            <%= f.label :health_specialty, "Specialite", class: "form-label" %>
              <%= f.select :health_specialty,
                options_for_select(@specialties || [], @company.health_specialty),
                { include_blank: "Selectionner une specialite" },
                class: "form-control",
                data: { dependent_select_target: "specialtySelect" } %>
          </div>
          <div class="form-group">
            <%= f.label :convention_sector, "Conventionnement", class: "form-label" %>
            <%= f.select :convention_sector,
                  [
                    ["Non conventionne", "not_conventioned"],
                    ["Secteur 1", "sector_1"],
                    ["Secteur 2", "sector_2"]
                  ],
                  { include_blank: "Selectionner" },
                  class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="form-group" style="margin-top:4px;">
        <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
          <%= f.check_box :teleconsultation_enabled %>
          <span>Propose la teleconsultation</span>
        </label>
        <span class="form-hint">Activez uniquement si vous proposez des consultations a distance.</span>
      </div>

      <% if @company.healthcare_professional? %>
        <div class="form-group">
          <%= f.label :accessibility_info, "Accessibilite", class: "form-label" %>
          <%= f.text_area :accessibility_info, class: "form-control", rows: 2,
                placeholder: "Ascenseur, acces PMR, etage, parking, transports..." %>
          <span class="form-hint">Visible publiquement pour rassurer avant la reservation.</span>
        </div>

        <div class="form-group">
          <%= f.label :practical_info, "Informations pratiques", class: "form-label" %>
          <%= f.text_area :practical_info, class: "form-control", rows: 3,
                placeholder: "Documents a apporter, duree moyenne, consignes avant consultation..." %>
        </div>

        <div class="form-group">
          <%= f.label :cancellation_policy, "Modalites d'annulation", class: "form-label" %>
          <%= f.text_area :cancellation_policy, class: "form-control", rows: 2,
                placeholder: "Annulation sans frais jusqu'a 24h avant le rendez-vous..." %>
          <span class="form-hint">Champ requis pour les profils sante.</span>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :description, "Description", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 4,
              placeholder: "Décrivez votre activité, votre expérience, votre zone d'intervention..." %>
        <span class="form-hint">Visible sur votre fiche publique</span>
      </div>
    </div>

    <div class="card-footer responsive-form-actions" style="display:flex; gap:10px; justify-content:flex-end;">
      <%= link_to "Annuler", company_profile_path, class: "btn btn-ghost" %>
      <%= f.submit "Sauvegarder", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
