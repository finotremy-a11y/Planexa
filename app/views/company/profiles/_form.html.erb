<%= form_with model: [:company, @company], url: company_profile_path,
      method: :patch, local: true do |f| %>
  <div class="card" style="max-width:680px;">
    <div class="card-header">
      <h3 style="font-family:var(--font-display);">Informations entreprise</h3>
    </div>
    <div class="card-body">
      <% if @company.errors.any? %>
        <div class="alert alert-error" style="margin-bottom:20px;">
          <% @company.errors.full_messages.each do |msg| %>
            <div>• <%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, "Nom de l'entreprise", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Plomberie Dupont & Fils" %>
      </div>

      <div class="form-group">
        <%= f.label :siret, "SIRET", class: "form-label" %>
        <%= f.text_field :siret, class: "form-control", placeholder: "14 chiffres", maxlength: 14 %>
      </div>

      <div class="form-group">
        <%= f.label :address, "Adresse", class: "form-label" %>
        <%= f.text_field :address, class: "form-control", placeholder: "12 rue des Artisans" %>
      </div>

      <div style="display:grid; grid-template-columns:2fr 1fr; gap:12px;">
        <div class="form-group">
          <%= f.label :city, "Ville", class: "form-label" %>
          <%= f.text_field :city, class: "form-control", placeholder: "Lyon" %>
        </div>
        <div class="form-group">
          <%= f.label :zip_code, "Code postal", class: "form-label" %>
          <%= f.text_field :zip_code, class: "form-control", placeholder: "69001" %>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <div class="form-group">
          <%= f.label :phone, "Téléphone", class: "form-label" %>
          <%= f.phone_field :phone, class: "form-control", placeholder: "04 78 00 00 00" %>
        </div>
        <div class="form-group">
          <%= f.label :website, "Site web (optionnel)", class: "form-label" %>
          <%= f.url_field :website, class: "form-control", placeholder: "https://monsite.fr" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :description, "Description", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 4,
              placeholder: "Décrivez votre activité, votre expérience, votre zone d'intervention..." %>
        <span class="form-hint">Visible sur votre fiche publique</span>
      </div>
    </div>

    <div class="card-footer" style="display:flex; gap:10px; justify-content:flex-end;">
      <%= link_to "Annuler", company_profile_path, class: "btn btn-ghost" %>
      <%= f.submit "Sauvegarder", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
