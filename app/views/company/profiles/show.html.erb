<% content_for :title, "Profil entreprise" %>
<% content_for :page_title, "Profil entreprise" %>

<div class="page-header">
  <div class="page-header-left">
    <h1>Profil entreprise</h1>
    <p>Informations visibles par vos clients</p>
  </div>
  <div class="page-header-actions">
    <%= link_to "Modifier", edit_company_profile_path, class: "btn btn-primary" %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 320px; gap:24px;">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display);">Informations générales</h3>
      </div>
      <div class="card-body">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <div class="form-label">Nom de l'entreprise</div>
            <div style="font-weight:500;"><%= @company.name %></div>
          </div>
          <div>
            <div class="form-label">SIRET</div>
            <div style="font-weight:500; font-family:monospace;"><%= @company.siret %></div>
          </div>
          <div>
            <div class="form-label">Téléphone</div>
            <div style="font-weight:500;"><%= @company.phone.presence || "—" %></div>
          </div>
          <div>
            <div class="form-label">Site web</div>
            <% if @company.website.present? %>
              <a href="<%= @company.website %>" target="_blank" rel="noopener" style="color:var(--green-700); font-weight:500;">
                <%= @company.website %>
              </a>
            <% else %>
              <div style="color:var(--text-300);">—</div>
            <% end %>
          </div>
        </div>

        <div style="margin-top:16px;">
          <div class="form-label">Adresse</div>
          <div style="font-weight:500;">
            <%= @company.address %><br>
            <%= @company.zip_code %> <%= @company.city %>
          </div>
        </div>

        <% if @company.description.present? %>
          <div style="margin-top:16px;">
            <div class="form-label">Description</div>
            <div style="background:var(--cream); padding:14px; border-radius:var(--radius-md);
                        line-height:1.7; font-size:0.9rem;">
              <%= @company.description %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display);">Prestations actives</h3>
      </div>
      <div class="card-body">
        <% if @company.service_types.active.any? %>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <% @company.service_types.active.each do |service_type| %>
              <span class="badge badge-green" style="font-size:0.82rem; padding:5px 12px;">
                <%= service_type.name %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p style="color:var(--text-300); font-size:0.85rem;">
            Aucune prestation.
            <%= link_to "Ajouter →", new_company_service_type_path, style: "color:var(--green-700);" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <div class="card" style="position:sticky; top:80px;">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;">Aperçu public</h3>
      </div>
      <div class="card-body" style="text-align:center;">
        <div style="width:64px; height:64px; background:var(--green-100);
                    border-radius:var(--radius-lg); display:flex; align-items:center;
                    justify-content:center; font-size:1.6rem; font-weight:700;
                    color:var(--green-800); margin:0 auto 12px;
                    font-family:var(--font-display);">
          <%= @company.name[0].upcase %>
        </div>
        <div style="font-weight:600; margin-bottom:4px;"><%= @company.name %></div>
        <div style="font-size:0.82rem; color:var(--text-500); margin-bottom:16px;">
          📍 <%= @company.city %>
        </div>
        <%= link_to "Voir ma fiche publique →",
              company_public_path(@company),
              class: "btn btn-secondary btn-sm",
              target: "_blank",
              rel: "noopener",
              style: "width:100%; justify-content:center;" %>
      </div>
    </div>
  </div>
</div>
