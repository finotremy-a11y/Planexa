<% content_for :title, t("profiles.title") %>
<% content_for :page_title, t("profiles.title") %>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= t("profiles.title") %></h1>
    <p><%= t("profiles.subtitle") %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to t("common.edit"), edit_company_profile_path, class: "btn btn-primary" %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 320px; gap:24px;">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display);"><%= t("profiles.general_info") %></h3>
      </div>
      <div class="card-body">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <div class="form-label">Logo</div>
            <% if @company.logo_url.present? %>
              <%= image_tag @company.logo_url,
                    alt: "Logo #{@company.name}",
                    style: "width:64px; height:64px; object-fit:cover; border-radius:10px; border:1px solid var(--border-light);" %>
            <% else %>
              <div style="color:var(--text-300);">—</div>
            <% end %>
          </div>

          <div>
            <div class="form-label"><%= t("profiles.company_name") %></div>
            <div style="font-weight:500;"><%= @company.name %></div>
          </div>
          <div>
            <div class="form-label"><%= t("common.siret") %></div>
            <div style="font-weight:500; font-family:monospace;"><%= @company.siret %></div>
          </div>
          <div>
            <div class="form-label"><%= t("common.phone") %></div>
            <div style="font-weight:500;"><%= @company.phone.presence || "—" %></div>
          </div>
          <div>
            <div class="form-label"><%= t("profiles.website") %></div>
            <% if @company.website.present? %>
              <a href="<%= @company.website %>" target="_blank" rel="noopener" style="color:var(--green-700); font-weight:500;">
                <%= @company.website %>
              </a>
            <% else %>
              <div style="color:var(--text-300);">—</div>
            <% end %>
          </div>
          <div>
            <div class="form-label"><%= t("profiles.professional_category") %></div>
            <div style="font-weight:500;">
              <%= @company.healthcare_professional? ? t("profiles.healthcare_professional") : t("profiles.standard_business") %>
            </div>
          </div>
        </div>

        <div style="margin-top:16px;">
          <div class="form-label"><%= t("common.address") %></div>
          <div style="font-weight:500;">
            <%= @company.address %><br>
            <%= @company.zip_code %> <%= @company.city %>
          </div>
        </div>

        <% if @company.healthcare_professional? %>
          <div style="margin-top:16px; display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <div class="form-label"><%= t("profiles.health_specialty") %></div>
              <div style="font-weight:500;"><%= @company.health_specialty.presence || "—" %></div>
            </div>
            <div>
              <div class="form-label"><%= t("profiles.convention_sector") %></div>
              <div style="font-weight:500;">
                <%= t("profiles.convention_sectors.#{@company.convention_sector}", default: "—") %>
              </div>
            </div>
            <div>
              <div class="form-label"><%= t("profiles.teleconsultation") %></div>
              <div style="font-weight:500;">
                <%= @company.teleconsultation_enabled? ? t("profiles.yes") : t("profiles.no") %>
              </div>
            </div>
          </div>

          <div style="margin-top:16px; display:grid; grid-template-columns:1fr; gap:12px;">
            <div>
              <div class="form-label">Accessibilite</div>
              <div style="font-weight:500;"><%= @company.accessibility_info.presence || "—" %></div>
            </div>
            <div>
              <div class="form-label">Informations pratiques</div>
              <div style="font-weight:500;"><%= @company.practical_info.presence || "—" %></div>
            </div>
            <div>
              <div class="form-label">Modalites d'annulation</div>
              <div style="font-weight:500;"><%= @company.cancellation_policy.presence || "—" %></div>
            </div>
          </div>
        <% end %>

        <% if @company.description.present? %>
          <div style="margin-top:16px;">
            <div class="form-label"><%= t("common.description") %></div>
            <div style="background:var(--cream); padding:14px; border-radius:var(--radius-md);
                        line-height:1.7; font-size:0.9rem;">
              <%= @company.description %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display);"><%= t("profiles.active_services") %></h3>
      </div>
      <div class="card-body">
        <% if @company.service_types.active.any? %>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <% @company.service_types.active.each do |service_type| %>
              <span class="badge badge-green" style="font-size:0.82rem; padding:5px 12px;">
                <%= service_type.name %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p style="color:var(--text-300); font-size:0.85rem;">
            <%= t("profiles.no_services") %>
            <%= link_to t("profiles.add_service"), new_company_service_type_path, style: "color:var(--green-700);" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <div class="card" style="position:sticky; top:80px;">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;"><%= t("profiles.public_preview") %></h3>
      </div>
      <div class="card-body" style="text-align:center;">
        <% if @company.logo_url.present? %>
          <%= image_tag @company.logo_url,
                alt: "Logo #{@company.name}",
                style: "width:64px; height:64px; border-radius:var(--radius-lg); object-fit:cover; margin:0 auto 12px; border:1px solid var(--border-light);" %>
        <% else %>
          <div style="width:64px; height:64px; background:var(--green-100);
                      border-radius:var(--radius-lg); display:flex; align-items:center;
                      justify-content:center; font-size:1.6rem; font-weight:700;
                      color:var(--green-800); margin:0 auto 12px;
                      font-family:var(--font-display);">
            <%= @company.name[0].upcase %>
          </div>
        <% end %>
        <div style="font-weight:600; margin-bottom:4px;"><%= @company.name %></div>
        <div style="font-size:0.82rem; color:var(--text-500); margin-bottom:16px;">
          📍 <%= @company.city %>
          <% if @company.healthcare_professional? && @company.health_specialty.present? %>
            <br><span style="font-size:0.78rem;"><%= @company.health_specialty %></span>
          <% end %>
        </div>
        <%= link_to t("profiles.view_public_page"),
              company_public_path(@company),
              class: "btn btn-secondary btn-sm",
              target: "_blank",
              rel: "noopener",
              style: "width:100%; justify-content:center;" %>
      </div>
    </div>

    <!-- 🚨 Danger Zone -->
    <div class="card" style="border-color:var(--red-200); background:var(--red-50);">
      <div class="card-header" style="border-color:var(--red-200);">
        <h3 style="font-family:var(--font-display); font-size:1rem; color:var(--red-700);">
          ⚠️ <%= t("profiles.danger_zone") %>
        </h3>
      </div>
      <div class="card-body">
        <p style="font-size:0.85rem; color:var(--text-600); margin-bottom:12px;">
          <%= t("profiles.delete_account_irreversible").html_safe %>
        </p>
        <%= button_to t("profiles.delete_account"),
              company_profile_path(@company),
              method: :delete,
              data: {
                confirm: t("profiles.delete_account_confirmation")
              },
              class: "btn btn-danger btn-sm",
              style: "width:100%; justify-content:center;" %>
        <p style="font-size:0.75rem; color:var(--red-600); margin-top:8px;">
          <%= t("profiles.delete_account_warning") %>
        </p>
      </div>
    </div>
  </div>
</div>
