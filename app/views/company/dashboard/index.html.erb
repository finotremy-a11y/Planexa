<% content_for :title, t("dashboard.title") %>
<% content_for :page_title, t("dashboard.title") %>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= t("dashboard.greeting", name: current_user.first_name) %> 👋</h1>
    <p><%= t("dashboard.subtitle") %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to new_company_appointment_path, class: "btn btn-primary" do %>
      <%= t("dashboard.new_appointment_button") %>
    <% end %>
  </div>
</div>

<!-- Stats -->
<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap:16px; margin-bottom:32px;">
  <div class="stat-card green">
    <div class="stat-icon green">📅</div>
    <div class="stat-value"><%= @today_appointments %></div>
    <div class="stat-label"><%= t("dashboard.today_appointments") %></div>
  </div>
  <div class="stat-card gold">
    <div class="stat-icon gold">⏳</div>
    <div class="stat-value"><%= @unassigned_count %></div>
    <div class="stat-label"><%= t("dashboard.unassigned") %></div>
    <% if @unassigned_count > 0 %>
      <a href="<%= unassigned_company_appointments_path %>"
         style="font-size:0.78rem; color:var(--gold-600); margin-top:8px; display:block;">
        <%= t("common.view_button") %>
      </a>
    <% end %>
  </div>
  <div class="stat-card green">
    <div class="stat-icon green">🚀</div>
    <div class="stat-value"><%= @bookings_generated_this_month %></div>
    <div class="stat-label"><%= t("dashboard.bookings_generated_this_month") %></div>
  </div>
  <div class="stat-card brown">
    <div class="stat-icon brown">📈</div>
    <div class="stat-value"><%= number_to_currency(@estimated_turnover_this_month, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></div>
    <div class="stat-label"><%= t("dashboard.estimated_turnover_this_month") %></div>
    <div style="font-size:0.72rem; color:var(--text-400); margin-top:6px;"><%= t("dashboard.estimated_turnover_formula") %></div>
  </div>
  <div class="stat-card gold">
    <div class="stat-icon gold">🛡️</div>
    <div class="stat-value"><%= @no_show_avoided_this_month %></div>
    <div class="stat-label"><%= t("dashboard.no_show_avoided_this_month") %></div>
    <div style="font-size:0.72rem; color:var(--text-400); margin-top:6px;"><%= t("dashboard.no_show_avoided_formula") %></div>
  </div>
  <div class="stat-card brown">
    <div class="stat-icon brown">👥</div>
    <div class="stat-value"><%= @employees_count %></div>
    <div class="stat-label"><%= t("dashboard.active_employees") %></div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon green">💶</div>
    <div class="stat-value"><%= number_to_currency(@monthly_revenue, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></div>
    <div class="stat-label"><%= t("dashboard.monthly_revenue") %></div>
  </div>
</div>

<!-- Quick settings banner if not configured -->
<% unless @company.setting.booking_public? || @company.employees.any? %>
  <div class="alert alert-warning" style="margin-bottom:24px;">
    ⚠️ <%= t("dashboard.setup_warning") %>
    <%= link_to t("dashboard.setup_now"), company_employees_path, style: "font-weight:600; color:var(--gold-700); margin-left:8px;" %>
  </div>
<% end %>

<div style="display:grid; grid-template-columns: 1fr 340px; gap:24px;">

  <!-- Prochains RDV -->
  <div class="card">
    <div class="card-header">
      <h3 style="font-family:var(--font-display);"><%= t("dashboard.upcoming_appointments") %></h3>
      <%= link_to t("common.see_all"), company_appointments_path, class: "btn btn-ghost btn-sm" %>
    </div>
    <% if @upcoming_appointments.any? %>
      <div class="table-wrapper" style="border:none; border-radius:0;">
        <table>
          <thead>
            <tr>
              <th><%= t("dashboard.date_time_header") %></th>
              <th><%= t("common.service_type") %></th>
              <th><%= t("common.client") %></th>
              <th><%= t("common.employee") %></th>
              <th><%= t("common.status") %></th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_appointments.each do |appt| %>
              <tr>
                <td>
                  <div style="font-weight:500;">
                    <%= appt.scheduled_at.strftime("%d/%m à %Hh%M") %>
                  </div>
                  <div style="font-size:0.78rem; color:var(--text-300);">
                    <%= appt.duration_minutes %> min
                  </div>
                </td>
                <td><%= appt.service_type.name %></td>
                <td>
                  <%= appt.client_user&.full_name || "<span style='color:var(--text-300)'>—</span>".html_safe %>
                </td>
                <td>
                  <% if appt.employee %>
                    <%= appt.employee.full_name %>
                  <% else %>
                    <span class="badge badge-gold"><%= t("appointments.unassigned_label") %></span>
                  <% end %>
                </td>
                <td>
                  <% cls_map = { "pending" => "badge-gold", "confirmed" => "badge-green", "cancelled" => "badge-red", "completed" => "badge-grey" } %>
                  <% cls = cls_map[appt.status] || "badge-grey" %>
                  <span class="badge <%= cls %>"><%= t("statuses.#{appt.status}", default: appt.status) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-state-icon">📭</div>
        <h3><%= t("dashboard.no_upcoming") %></h3>
        <p><%= t("dashboard.empty_state_text") %></p>
        <%= link_to t("common.create_appointment"), new_company_appointment_path,
              class: "btn btn-primary", style: "margin-top:16px;" %>
      </div>
    <% end %>
  </div>

  <!-- Panneau latéral -->
  <div style="display:flex; flex-direction:column; gap:16px;">

    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;">Relance clients</h3>
      </div>
      <div class="card-body" style="padding:16px 20px;">
        <p style="margin:0 0 12px 0; font-size:0.84rem; color:var(--text-500);">
          Reperez les clients inactifs et relancez-les en quelques clics.
        </p>
        <%= link_to "Voir les clients inactifs ->", company_inactive_clients_path, class: "btn btn-secondary btn-sm" %>
      </div>
    </div>

    <!-- Checklist onboarding -->
    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;"><%= t("dashboard.onboarding_title") %></h3>
      </div>
      <div class="card-body" style="padding:16px 20px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <strong style="font-size:0.9rem;"><%= t("dashboard.onboarding_progress") %></strong>
          <span class="badge badge-brown"><%= @onboarding_completion_percentage %>%</span>
        </div>

        <div style="height:8px; border-radius:999px; background:var(--gray-100); overflow:hidden; margin-bottom:14px;">
          <div style="height:8px; width:<%= @onboarding_completion_percentage %>%; background:var(--green-600);"></div>
        </div>

        <div style="margin-bottom:12px;">
          <% if @ready_to_receive_bookings %>
            <span class="badge badge-green"><%= t("dashboard.go_live_ready") %></span>
          <% else %>
            <span class="badge badge-gold"><%= t("dashboard.go_live_incomplete") %></span>
          <% end %>
        </div>

        <% if @onboarding_blockers.any? %>
          <div style="margin-bottom:12px; font-size:0.82rem; color:var(--text-500);">
            <%= t("dashboard.blockers_title") %>
          </div>
        <% end %>

        <div style="display:flex; flex-direction:column; gap:8px;">
          <% @onboarding_items.each do |item| %>
            <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
              <%= link_to t("dashboard.onboarding_items.#{item[:key]}"),
                    public_send(item[:path]),
                    style: "font-size:0.84rem; color:var(--text-700);" %>
              <% if item[:completed] %>
                <span class="badge badge-green">✓</span>
              <% elsif item[:required] %>
                <span class="badge badge-gold"><%= t("dashboard.required") %></span>
              <% else %>
                <span class="badge badge-grey"><%= t("dashboard.optional") %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Réglages rapides -->
    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;"><%= t("dashboard.active_settings") %></h3>
        <%= link_to t("common.edit"), company_settings_path, class: "btn btn-ghost btn-sm" %>
      </div>
      <div class="card-body" style="padding:16px 20px;">
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.85rem; color:var(--text-700);"><%= t("dashboard.bookings_label") %></span>
            <span class="badge <%= @company.setting.booking_public? ? 'badge-green' : 'badge-grey' %>">
              <%= @company.setting.booking_public? ? t("dashboard.online") : t("dashboard.private") %>
            </span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.85rem; color:var(--text-700);"><%= t("dashboard.payment_label") %></span>
            <span class="badge <%= @company.setting.in_app_payment? ? 'badge-green' : 'badge-grey' %>">
              <%= @company.setting.in_app_payment? ? t("dashboard.in_app") : t("dashboard.out_app") %>
            </span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.85rem; color:var(--text-700);"><%= t("dashboard.assignment_label") %></span>
            <span class="badge <%= @company.setting.auto_assignment? ? 'badge-green' : 'badge-brown' %>">
              <%= @company.setting.auto_assignment? ? t("dashboard.auto") : t("dashboard.manual") %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Équipe -->
    <div class="card">
      <div class="card-header">
        <h3 style="font-family:var(--font-display); font-size:1rem;"><%= t("common.team") %></h3>
        <%= link_to t("common.add_button"), new_company_employee_path, class: "btn btn-ghost btn-sm" %>
      </div>
      <% if @company.employees.active.any? %>
        <div style="padding:8px 0;">
          <% @company.employees.active.limit(5).each do |emp| %>
            <div style="display:flex; align-items:center; gap:10px; padding:8px 20px;">
              <div style="width:32px; height:32px; background:var(--green-100);
                          border-radius:50%; display:flex; align-items:center;
                          justify-content:center; font-size:0.78rem; font-weight:600;
                          color:var(--green-800);">
                <%= emp.first_name[0] %><%= emp.last_name[0] %>
              </div>
              <div>
                <div style="font-size:0.85rem; font-weight:500;"><%= emp.full_name %></div>
                <div style="font-size:0.72rem; color:var(--text-300);">
                  <%= t("dashboard.skill_one", count: emp.service_types.count, default: t("dashboard.skill_other")) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="padding:20px; text-align:center; color:var(--text-300); font-size:0.85rem;">
          <%= t("dashboard.no_employee_in_list") %><br>
          <%= link_to t("dashboard.add_first"), new_company_employee_path,
                style: "color:var(--green-700);" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
