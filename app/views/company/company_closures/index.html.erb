<% content_for :title, "Fermetures ponctuelles" %>
<% content_for :page_title, "Fermetures ponctuelles" %>

<div class="page-header">
  <div class="page-header-left">
    <h1>Fermetures ponctuelles du cabinet</h1>
    <p>Bloquez des periodes exceptionnelles (conges, formation, fermeture temporaire).</p>
  </div>
  <div class="page-header-actions">
    <%= link_to "+ Ajouter une fermeture", new_company_company_closure_path, class: "btn btn-primary" %>
    <%= link_to "← Retour reglages", company_settings_path, class: "btn btn-ghost" %>
  </div>
</div>

<div class="card">
  <div class="card-body" style="padding:0;">
    <% if @company_closures.any? %>
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="border-bottom:1px solid var(--border);">
            <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Debut</th>
            <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Fin</th>
            <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Motif</th>
            <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Note</th>
            <th style="text-align:right; padding:10px 14px; font-size:0.75rem; color:var(--text-400);"></th>
          </tr>
        </thead>
        <tbody>
          <% @company_closures.each do |closure| %>
            <tr style="border-bottom:1px solid var(--border);">
              <td style="padding:10px 14px;"><%= closure.starts_at.strftime("%d/%m/%Y %Hh%M") %></td>
              <td style="padding:10px 14px;"><%= closure.ends_at.strftime("%d/%m/%Y %Hh%M") %></td>
              <td style="padding:10px 14px;"><%= closure.reason.presence || "—" %></td>
              <td style="padding:10px 14px; color:var(--text-500); max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                <%= closure.note.presence || "—" %>
              </td>
              <td style="padding:10px 14px; text-align:right;">
                <%= button_to "Supprimer",
                      company_company_closure_path(closure),
                      method: :delete,
                      class: "btn btn-danger btn-sm",
                      data: { turbo_confirm: "Supprimer cette fermeture ponctuelle ?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="padding:24px; color:var(--text-400);">
        Aucune fermeture ponctuelle enregistree pour le moment.
      </div>
    <% end %>
  </div>
</div>
