<% content_for :title, "Mon abonnement" %>
<% content_for :page_title, "Mon abonnement" %>

<div class="card" style="max-width:640px; margin:0 auto;">
  <% if params[:success] %>
    <div class="flash flash-success" style="margin-bottom:24px;">
      🎉 Votre abonnement est activé — bienvenue sur Planify Pro !
    </div>
  <% end %>
  <% if params[:canceled] %>
    <div class="flash flash-warning" style="margin-bottom:24px;">
      La procédure de paiement a été annulée. Vous pouvez réessayer à tout moment.
    </div>
  <% end %>

  <% if @subscription&.active? %>
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
      <span class="badge badge-success" style="font-size:1rem;">Actif</span>
      <h2 style="margin:0;">Abonnement Planify Pro</h2>
    </div>

    <dl style="display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; margin-bottom:32px;">
      <dt style="color:var(--text-400); font-size:0.85rem;">Plan</dt>
      <dd>Pro — 49 € / mois</dd>

      <% if @subscription.trial_ends_at&.future? %>
        <dt style="color:var(--text-400); font-size:0.85rem;">Fin d'essai</dt>
        <dd><%= @subscription.trial_ends_at.strftime("%d/%m/%Y") %></dd>
      <% end %>

      <% if @subscription.current_period_end.present? %>
        <dt style="color:var(--text-400); font-size:0.85rem;">Prochain prélèvement</dt>
        <dd><%= @subscription.current_period_end.strftime("%d/%m/%Y") %></dd>
      <% end %>
    </dl>

    <div style="display:flex; gap:12px; flex-wrap:wrap;">
      <%= button_to "Gérer mon abonnement (portail Stripe)", portal_company_subscription_path,
            method: :post,
            class: "btn btn-secondary",
            data: { turbo: false } %>

      <%= button_to "Annuler l'abonnement", company_subscription_path,
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: "Confirmer l'annulation ? Votre accès restera actif jusqu'à la fin de la période." } %>
    </div>

  <% elsif @subscription&.trialing? %>
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
      <span class="badge badge-info" style="font-size:1rem;">Période d'essai</span>
      <h2 style="margin:0;">Abonnement Planify Pro</h2>
    </div>

    <p>
      Votre essai gratuit se termine le
      <strong><%= @subscription.trial_ends_at&.strftime("%d/%m/%Y") %></strong>.
      Abonnez-vous maintenant pour ne pas perdre l'accès.
    </p>

    <%= button_to "Activer l'abonnement — 49 €/mois", company_subscription_path,
          method: :post,
          class: "btn btn-primary",
          data: { turbo: false } %>

  <% else %>
    <div style="text-align:center; padding:32px 0;">
      <div style="font-size:3rem; margin-bottom:16px;">🔒</div>
      <h2 style="margin-bottom:8px;">Aucun abonnement actif</h2>
      <p style="color:var(--text-500); margin-bottom:32px;">
        Abonnez-vous pour accéder à toutes les fonctionnalités.
      </p>
      <%= button_to "Commencer — 14 jours gratuits", company_subscription_path,
            method: :post,
            class: "btn btn-primary btn-lg",
            data: { turbo: false } %>
    </div>
  <% end %>
</div>
