<% content_for :page_title, "Messagerie" %>

<div style="max-width:1060px; margin:0 auto;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; gap:10px; flex-wrap:wrap;">
    <div>
      <h1 style="margin:0;">Messagerie clients
        <% if @total_unread_count.to_i.positive? %>
          <span style="display:inline-flex; align-items:center; justify-content:center; min-width:22px; height:22px; padding:0 6px; margin-left:8px; border-radius:999px; background:#dc2626; color:white; font-size:0.75rem; vertical-align:middle;"><%= @total_unread_count %></span>
        <% end %>
      </h1>
      <p style="color:var(--text-500); margin:6px 0 0 0;">Repondez rapidement a vos clients et partagez des photos.</p>
    </div>
  </div>

  <div class="card" style="padding:0; overflow:hidden;">
    <div style="padding:14px 18px; border-bottom:1px solid var(--border-light); background:var(--surface-100);">
      <strong>Conversations actives</strong>
    </div>

    <% if @conversations.empty? %>
      <div style="padding:26px 18px; color:var(--text-500);">
        Aucune conversation disponible. Les conversations sont creees automatiquement des qu'un client a un rendez-vous avec votre entreprise.
      </div>
    <% else %>
      <% @conversations.each do |conversation| %>
        <% last_message = conversation.last_message %>
        <% unread_count = conversation.unread_count_for(current_user) %>
        <%= link_to company_conversation_path(conversation),
              style: "display:block; padding:14px 18px; border-bottom:1px solid var(--border-light); text-decoration:none;" do %>
          <div style="display:flex; justify-content:space-between; gap:10px; align-items:flex-start;">
            <div>
              <div style="font-weight:700; color:var(--text-900); display:flex; align-items:center; gap:8px;">
                <span><%= conversation.title_for_company %></span>
                <% if unread_count.positive? %>
                  <span style="display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; padding:0 6px; border-radius:999px; background:#dc2626; color:white; font-size:0.72rem;"><%= unread_count %></span>
                <% end %>
              </div>
              <div style="font-size:0.85rem; color:var(--text-500); margin-top:2px;">
                <%= last_message&.body&.truncate(70) || "Commencer la conversation" %>
              </div>
            </div>
            <% if last_message %>
              <span style="font-size:0.75rem; color:var(--text-400); white-space:nowrap;">
                <%= last_message.created_at.strftime("%d/%m %H:%M") %>
              </span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
