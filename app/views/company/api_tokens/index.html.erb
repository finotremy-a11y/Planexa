<% content_for :title, "API Tokens" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">API publique</h1>
      <p class="text-muted mb-0">Générez des tokens pour vos intégrations CRM, ERP et outils externes.</p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5">Créer un token</h2>
      <%= form_with url: company_api_tokens_path, method: :post, local: true do %>
        <div class="row g-3">
          <div class="col-md-4">
            <%= label_tag :name, "Nom", class: "form-label" %>
            <%= text_field_tag :name, nil, class: "form-control", placeholder: "Ex: Zapier Prod" %>
          </div>
          <div class="col-md-4">
            <%= label_tag :expires_at, "Expire le (optionnel)", class: "form-label" %>
            <%= datetime_local_field_tag :expires_at, nil, class: "form-control" %>
          </div>
        </div>

        <div class="mt-3">
          <div class="form-label">Scopes</div>
          <% [
            "read:appointments",
            "write:appointments",
            "read:employees",
            "read:service_types",
            "read:customers",
            "read:webhooks",
            "write:webhooks"
          ].each do |scope| %>
            <div class="form-check form-check-inline">
              <%= check_box_tag "scopes[]", scope, false, id: "scope_#{scope.parameterize}", class: "form-check-input" %>
              <%= label_tag "scope_#{scope.parameterize}", scope, class: "form-check-label" %>
            </div>
          <% end %>
        </div>

        <div class="mt-3">
          <%= submit_tag "Créer le token", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h2 class="h5">Tokens existants</h2>
      <% if @api_tokens.any? %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Scopes</th>
                <th>Dernière utilisation</th>
                <th>Expiration</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @api_tokens.each do |token| %>
                <tr>
                  <td><strong><%= token.name %></strong></td>
                  <td><%= token.scopes.join(", ") %></td>
                  <td><%= token.last_used_at ? l(token.last_used_at, format: :short) : "Jamais" %></td>
                  <td>
                    <% if token.expires_at.present? %>
                      <%= l(token.expires_at, format: :short) %>
                    <% else %>
                      Sans expiration
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= button_to "Supprimer", company_api_token_path(token),
                          method: :delete,
                          data: { turbo_confirm: "Supprimer ce token ?" },
                          class: "btn btn-sm btn-outline-danger" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted mb-0">Aucun token créé pour le moment.</p>
      <% end %>
    </div>
  </div>
</div>
