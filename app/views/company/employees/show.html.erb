<% content_for :title, @employee.full_name %>
<% content_for :page_title, t("employees.show_title") %>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= @employee.full_name %></h1>
    <p><%= @employee.email %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to t("common.edit"), edit_company_employee_path(@employee), class: "btn btn-secondary" %>
    <%= link_to t("common.back_to_list"), company_employees_path, class: "btn btn-ghost" %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
  <!-- Aptitudes -->
  <div class="card">
    <div class="card-header">
      <h3 style="font-family:var(--font-display);"><%= t("employees.skills") %></h3>
      <%= link_to t("common.manage"), company_employee_skills_path(@employee), class: "btn btn-ghost btn-sm" %>
    </div>
    <div class="card-body">
      <% if @skills.any? %>
        <div style="display:flex; flex-direction:column; gap:10px;">
          <% @skills.each do |skill| %>
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:500; font-size:0.9rem;"><%= skill.service_type.name %></span>
              <span class="badge badge-grey"><%= skill.level %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color:var(--text-300); font-size:0.85rem;"><%= t("employees.no_skills_assigned") %></p>
        <%= link_to t("employees.add_skills"), company_employee_skills_path(@employee),
              style: "font-size:0.85rem; color:var(--green-700);" %>
      <% end %>
    </div>
  </div>

  <!-- Horaires -->
  <div class="card">
    <div class="card-header">
      <h3 style="font-family:var(--font-display);"><%= t("employees.schedules") %></h3>
      <%= link_to t("common.manage"), company_employee_schedules_path(@employee), class: "btn btn-ghost btn-sm" %>
    </div>
    <div class="card-body">
      <% day_names = t("employees.day_names") %>
      <% if @schedules.any? %>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <% @schedules.each do |s| %>
            <div style="display:flex; justify-content:space-between; font-size:0.88rem;">
              <span style="font-weight:500;"><%= day_names[s.day_of_week] %></span>
              <span style="color:var(--text-500);">
                <%= s.start_time.strftime("%Hh%M") %> - <%= s.end_time.strftime("%Hh%M") %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color:var(--text-300); font-size:0.85rem;"><%= t("employees.no_schedules") %></p>
        <%= link_to t("employees.set_schedules"), company_employee_schedules_path(@employee),
              style: "font-size:0.85rem; color:var(--green-700);" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Absences -->
<div class="card" style="margin-top:24px;">
  <div class="card-header">
    <h3 style="font-family:var(--font-display);"><%= t("employees.absences") %></h3>
    <%= link_to t("common.manage"), company_employee_employee_absences_path(@employee), class: "btn btn-ghost btn-sm" %>
  </div>
  <div class="card-body">
    <% if @absences.any? %>
      <% upcoming = @absences.select { |a| a.starts_at > Time.current }.first(3) %>
      <% if upcoming.any? %>
        <div style="display:flex; flex-direction:column; gap:8px;">
          <% upcoming.each do |absence| %>
            <div style="display:flex; justify-content:space-between; font-size:0.88rem;
                        padding:8px 0; border-bottom:1px solid var(--border);">
              <span style="font-weight:500; color:var(--gold-700);">
                <%= absence.reason_label %>
              </span>
              <span style="color:var(--text-400);">
                <%= absence.starts_at.strftime("%d/%m/%Y") %> → <%= absence.ends_at.strftime("%d/%m/%Y") %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color:var(--text-300); font-size:0.85rem;"><%= t("employees.no_upcoming_absences") %></p>
      <% end %>
    <% else %>
      <p style="color:var(--text-300); font-size:0.85rem;"><%= t("employees.no_absences") %></p>
    <% end %>
    <%= link_to t("employees.add_absence"), new_company_employee_employee_absence_path(@employee),
          style: "font-size:0.85rem; color:var(--green-700); margin-top:8px; display:inline-block;" %>
  </div>
</div>
