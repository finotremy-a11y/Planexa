<% content_for :title, t("services.title") %>
<% content_for :page_title, t("services.title") %>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= t("services.title") %></h1>
    <p><%= pluralize(@service_types.count, t("services.count_one"), t("services.count_other")) %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to new_company_service_type_path, class: "btn btn-primary" do %>
      <%= t("services.add_button") %>
    <% end %>
  </div>
</div>

<% if @service_types.any? %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th><%= t("common.name") %></th>
          <th><%= t("common.duration") %></th>
          <th><%= t("common.price") %></th>
          <th>Acompte</th>
          <th><%= t("services.qualified_employees") %></th>
          <th><%= t("common.status") %></th>
          <th><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @service_types.each do |st| %>
          <tr>
            <td>
              <div style="font-weight:500;"><%= st.name %></div>
              <% if st.description.present? %>
                <div style="font-size:0.78rem; color:var(--text-300);">
                  <%= truncate(st.description, length: 60) %>
                </div>
              <% end %>
            </td>
            <td><%= st.duration_minutes %> min</td>
            <td style="font-weight:600; color:var(--green-800);">
              <%= number_to_currency(st.price_cents / 100.0, unit:"€", separator:",", delimiter:" ", format:"%n %u") %>
            </td>
            <td>
              <% if st.deposit_required? %>
                <span class="badge badge-gold">
                  <% if st.deposit_fixed_cents? %>
                    <%= number_to_currency(st.deposit_amount_cents / 100.0, unit:"€", separator:",", delimiter:" ", format:"%n %u") %>
                  <% else %>
                    <%= st.deposit_value %>%
                  <% end %>
                </span>
              <% else %>
                <span class="badge badge-grey">Aucun</span>
              <% end %>
            </td>
            <td>
              <span class="badge badge-grey">
                <%= pluralize(st.qualified_employees.count, t("services.employee_one"), t("services.employee_other")) %>
              </span>
            </td>
            <td>
              <% if st.active? %>
                <span class="badge badge-green"><%= t("services.active") %></span>
              <% else %>
                <span class="badge badge-red"><%= t("services.inactive") %></span>
              <% end %>
            </td>
            <td>
              <div style="display:flex; gap:6px;">
                <%= link_to t("common.edit"), edit_company_service_type_path(st), class: "btn btn-ghost btn-sm" %>
                    <%= link_to st.active? ? t("common.deactivate") : t("common.activate"),
                      toggle_active_company_service_type_path(st),
                      data: { turbo_method: :patch },
                      class: "btn btn-ghost btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card">
    <div class="empty-state">
      <div class="empty-state-icon">🔧</div>
      <h3><%= t("services.empty_state") %></h3>
      <p><%= t("services.empty_state_text") %></p>
      <%= link_to t("services.create_first"), new_company_service_type_path,
            class: "btn btn-primary", style: "margin-top:16px;" %>
    </div>
  </div>
<% end %>
