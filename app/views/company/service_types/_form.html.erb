<% if local_assigns[:service_templates].present? && @service_type.new_record? %>
  <div class="card" style="max-width:600px; margin-bottom:16px;">
    <div class="card-header">
      <div style="display:flex; align-items:center; gap:10px;">
        <h2 style="font-size:1.05rem; margin:0;">Assistant de creation rapide</h2>
        <% if current_user.company.healthcare_professional? %>
          <span class="badge badge-green">🩺 Modèles médicaux</span>
        <% else %>
          <span class="badge badge-grey">💼 Modèles généralistes</span>
        <% end %>
      </div>
    </div>
    <div class="card-body" style="display:flex; flex-direction:column; gap:10px;">
      <p style="margin:0; color:var(--text-500); font-size:0.84rem;">
        Selectionnez jusqu'a 3 templates pour ajouter rapidement des prestations de base.
      </p>

      <%= form_with url: quick_create_company_service_types_path, method: :post, local: true do %>
        <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:12px;">
          <% service_templates.each do |key, template| %>
            <label style="display:flex; align-items:flex-start; gap:10px; padding:8px 10px; border:1px solid var(--border); border-radius:var(--radius-md);">
              <%= check_box_tag "template_keys[]", key, false %>
              <div>
                <div style="font-weight:600;"><%= template[:name] %></div>
                <div style="font-size:0.78rem; color:var(--text-400);">
                  <%= template[:duration_minutes] %> min · <%= number_to_currency(template[:price_cents] / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                </div>
              </div>
            </label>
          <% end %>
        </div>

        <div style="display:flex; justify-content:flex-end;">
          <%= submit_tag "Ajouter les templates selectionnes", class: "btn btn-secondary" %>
        </div>
      <% end %>

      <div style="padding-top:8px; border-top:1px solid var(--border);">
        <div style="font-size:0.78rem; color:var(--text-400); margin-bottom:8px;">Ou pre-remplir ce formulaire :</div>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% service_templates.each do |_key, template| %>
            <button type="button"
                    class="btn btn-ghost btn-sm"
                    data-template-name="<%= template[:name] %>"
                    data-template-description="<%= template[:description] %>"
                    data-template-duration="<%= template[:duration_minutes] %>"
                    data-template-price="<%= template[:price_cents] %>">
              <%= template[:name] %>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= form_with model: [:company, @service_type], local: true do |f| %>
  <div class="card" style="max-width:600px;">
    <div class="card-header">
      <h2 style="font-size:1.2rem;">
        <%= @service_type.new_record? ? "Créer une prestation" : "Modifier la prestation" %>
      </h2>
    </div>
    <div class="card-body">
      <% if @service_type.errors.any? %>
        <div class="alert alert-error" style="margin-bottom:20px;">
          <ul style="list-style:none; padding:0; margin:0;">
            <% @service_type.errors.full_messages.each do |msg| %>
              <li>• <%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, "Nom de la prestation", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Ex: Depannage plomberie" %>
      </div>
      <div class="form-group">
        <%= f.label :description, "Description", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", placeholder: "Décrivez la prestation..." %>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div class="form-group">
          <%= f.label :duration_minutes, "Durée (minutes)", class: "form-label" %>
          <%= f.number_field :duration_minutes, class: "form-control", min: 15, step: 15 %>
        </div>
        <div class="form-group">
          <%= f.label :price_cents, "Prix (en centimes, ex: 9000 = 90€)", class: "form-label" %>
          <%= f.number_field :price_cents, class: "form-control", min: 0 %>
          <span class="form-hint">Entrez le prix en centimes. 90€ = 9000</span>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div class="form-group">
          <%= f.label :deposit_kind, "Acompte", class: "form-label" %>
          <%= f.select :deposit_kind,
                [
                  [ "Aucun acompte", "deposit_none" ],
                  [ "Montant fixe (centimes)", "deposit_fixed_cents" ],
                  [ "Pourcentage (%)", "deposit_percentage" ]
                ],
                {},
                class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :deposit_value, "Valeur acompte", class: "form-label" %>
          <%= f.number_field :deposit_value, class: "form-control", min: 0 %>
          <span class="form-hint">Ex: 3000 (30€) ou 30 (%) selon le type.</span>
        </div>
      </div>
    </div>
    <div class="card-footer" style="display:flex; gap:10px; justify-content:flex-end;">
      <%= link_to "Annuler", company_service_types_path, class: "btn btn-ghost" %>
      <%= f.submit @service_type.new_record? ? "Créer la prestation" : "Sauvegarder",
            class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

<% if local_assigns[:service_templates].present? && @service_type.new_record? %>
  <script>
    (function() {
      const nameInput = document.getElementById("service_type_name");
      const descriptionInput = document.getElementById("service_type_description");
      const durationInput = document.getElementById("service_type_duration_minutes");
      const priceInput = document.getElementById("service_type_price_cents");

      const buttons = document.querySelectorAll("[data-template-name]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          nameInput.value = button.dataset.templateName || "";
          descriptionInput.value = button.dataset.templateDescription || "";
          durationInput.value = button.dataset.templateDuration || "";
          priceInput.value = button.dataset.templatePrice || "";
          nameInput.focus();
        });
      });
    })();
  </script>
<% end %>
