<% content_for :title, "Réglages" %>
<% content_for :page_title, "Réglages" %>

<div class="page-header">
  <div class="page-header-left">
    <h1>Réglages</h1>
    <p>Personnalisez le fonctionnement de votre espace DreamAgenda</p>
  </div>
</div>

<%= form_with model: [:company, @setting], url: company_settings_path, method: :patch, local: true do |f| %>
  <div style="display:grid; gap:20px; max-width:720px;">

    <!-- Bloc 1 : Prise de RDV -->
    <div class="card">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">📅 Prise de rendez-vous</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Comment vos clients peuvent-ils prendre rendez-vous ?
          </p>
        </div>
      </div>
      <div class="card-body">
        <div class="radio-cards">
          <label class="radio-card">
            <%= f.radio_button :booking_mode, "booking_public",
                  checked: @setting.booking_public? %>
            <div class="radio-card-content">
              <h4>🌐 Réservation publique (type Doctolib)</h4>
              <p>Vos créneaux sont visibles en ligne. Les clients peuvent réserver directement depuis votre fiche.</p>
            </div>
          </label>
          <label class="radio-card">
            <%= f.radio_button :booking_mode, "booking_private",
                  checked: @setting.booking_private? %>
            <div class="radio-card-content">
              <h4>🔒 Gestion privée</h4>
              <p>Vous saisissez vous-même les rendez-vous dans votre dashboard. Aucune réservation en ligne.</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Bloc 2 : Paiement -->
    <div class="card">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">💳 Paiement</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Comment les clients règlent-ils vos prestations ?
          </p>
        </div>
      </div>
      <div class="card-body">
        <div class="radio-cards">
          <label class="radio-card">
            <%= f.radio_button :payment_mode, "payment_external",
                  checked: @setting.payment_external? %>
            <div class="radio-card-content">
              <h4>🤝 Paiement hors application</h4>
              <p>Vous gérez le paiement directement avec vos clients (espèces, virement, CB sur place…).</p>
            </div>
          </label>
          <label class="radio-card">
            <%= f.radio_button :payment_mode, "payment_in_app",
                  checked: @setting.payment_in_app? %>
            <div class="radio-card-content">
              <h4>💸 Paiement en ligne via DreamAgenda</h4>
              <p>Les clients paient en ligne lors de la réservation. Les fonds arrivent directement sur votre compte Stripe.</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Bloc 3 : Assignation -->
    <div class="card">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">👤 Assignation des employés</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Qui désigne l'employé pour chaque rendez-vous ?
          </p>
        </div>
      </div>
      <div class="card-body">
        <div class="radio-cards">
          <label class="radio-card">
            <%= f.radio_button :assignment_mode, "assignment_automatic",
                  checked: @setting.assignment_automatic? %>
            <div class="radio-card-content">
              <h4>⚡ Assignation automatique</h4>
              <p>DreamAgenda désigne automatiquement l'employé disponible et qualifié, en équilibrant la charge de travail.</p>
            </div>
          </label>
          <label class="radio-card">
            <%= f.radio_button :assignment_mode, "assignment_manual",
                  checked: @setting.assignment_manual? %>
            <div class="radio-card-content">
              <h4>✋ Assignation manuelle</h4>
              <p>Vous choisissez vous-même quel employé est affecté à chaque rendez-vous depuis votre dashboard.</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- Bloc Stripe Connect — visible pour la connexion des paiements -->
    <div class="card" id="stripe-connect-block">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">💳 Connexion Stripe</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Nécessaire pour recevoir les paiements clients en ligne
          </p>
        </div>
      </div>
      <div class="card-body">
        <% if @company.stripe_onboarding_complete? %>
          <div class="alert alert-success">
            ✅ Votre compte Stripe est connecté. Vous pouvez recevoir des paiements.
          </div>
        <% elsif @company.stripe_account_id.present? %>
          <div class="alert alert-warning" style="margin-bottom:16px;">
            ⚠️ Votre compte Stripe n'est pas encore complètement configuré.
          </div>
          <%= link_to "Continuer la configuration Stripe →",
                connect_company_stripe_connect_path,
                class: "btn btn-gold" %>
        <% else %>
          <p style="color:var(--text-500); font-size:0.88rem; margin-bottom:16px;">
            Pour activer les paiements en ligne, connectez votre compte Stripe.
            Vos clients pourront payer directement lors de leur réservation.
            L'argent arrive directement sur votre compte.
          </p>
          <%= link_to "Connecter mon compte Stripe →",
                connect_company_stripe_connect_path,
                class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>

    <!-- Bloc rappels multi-canal -->
    <div class="card">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">🔔 Rappels clients (multi-canal)</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Activez ou desactivez chaque canal de rappel 24h avant le rendez-vous
          </p>
        </div>
      </div>
      <div class="card-body">
        <div class="setting-toggle-row" style="margin-bottom:10px;">
          <div class="setting-toggle-copy">
            <div style="font-weight:600; margin-bottom:4px;">Activer les rappels Email</div>
            <div style="font-size:0.82rem; color:var(--text-500);">
              Envoi d'un email de rappel aux clients 24h avant le rendez-vous.
            </div>
          </div>
          <label class="setting-toggle-control">
            <%= f.check_box :email_reminders_enabled,
                  style: "width:20px; height:20px; cursor:pointer;",
                  checked: @setting.email_reminders_enabled? %>
            <span style="font-size:0.85rem; color:var(--text-500);">Active</span>
          </label>
        </div>

        <div class="setting-toggle-row" style="margin-bottom:10px;">
          <div class="setting-toggle-copy">
            <div style="font-weight:600; margin-bottom:4px;">Activer les rappels SMS</div>
            <div style="font-size:0.82rem; color:var(--text-500);">
              Vos clients reçoivent un SMS J-1 avant leur RDV (si leur numéro est renseigné et qu'ils n'ont pas désactivé ces notifications).
            </div>
          </div>
          <label class="setting-toggle-control">
            <%= f.check_box :sms_reminders_enabled,
                  style: "width:20px; height:20px; cursor:pointer;",
                  checked: @setting.sms_reminders_enabled? %>
            <span style="font-size:0.85rem; color:var(--text-500);">Active</span>
          </label>
        </div>

        <div class="setting-toggle-row">
          <div class="setting-toggle-copy">
            <div style="font-weight:600; margin-bottom:4px;">Activer les rappels Push</div>
            <div style="font-size:0.82rem; color:var(--text-500);">
              Notification push envoyee aux clients ayant installe l'application web.
            </div>
          </div>
          <label class="setting-toggle-control">
            <%= f.check_box :push_reminders_enabled,
                  style: "width:20px; height:20px; cursor:pointer;",
                  checked: @setting.push_reminders_enabled? %>
            <span style="font-size:0.85rem; color:var(--text-500);">Active</span>
          </label>
        </div>

        <% if SmsService.credentials_present? %>
          <p style="font-size:0.78rem; color:var(--green-700); margin-top:8px;">
            Canal SMS configure (Twilio actif).
          </p>
        <% else %>
          <p style="font-size:0.78rem; color:var(--text-300); margin-top:8px;">
            Le canal SMS necessite la configuration Twilio (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER).
          </p>
        <% end %>
      </div>
    </div>

    <% if @company.healthcare_professional? %>
      <div class="card">
        <div class="card-header">
          <div>
            <h3 style="font-family:var(--font-display);">🩺 Disponibilite medicale avancee</h3>
            <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
              Parametrez les intervalles de consultation, buffers, surbooking controle et urgences.
            </p>
          </div>
        </div>
        <div class="card-body" style="display:grid; gap:14px;">
          <div>
            <label class="form-label">Intervalle de creneau (minutes)</label>
            <%= f.select :slot_interval_minutes,
                  options_for_select([ 5, 10, 15, 20, 30, 60 ], @setting.slot_interval_minutes),
                  {},
                  class: "input" %>
          </div>

          <div>
            <label class="form-label">Buffer entre rendez-vous (minutes)</label>
            <%= f.number_field :buffer_between_appointments_minutes,
                  class: "input", min: 0, max: 120, step: 5 %>
          </div>

          <div class="setting-toggle-row" style="padding:12px 14px;">
            <div class="setting-toggle-copy">
              <div style="font-weight:600;">Autoriser le surbooking controle</div>
              <div style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
                Permet d'accepter un chevauchement limite sur un creneau.
              </div>
            </div>
            <label class="setting-toggle-control">
              <%= f.check_box :allow_controlled_overbooking,
                    style: "width:20px; height:20px; cursor:pointer;" %>
              <span style="font-size:0.85rem; color:var(--text-500);">Active</span>
            </label>
          </div>

          <div>
            <label class="form-label">Limite de surbooking par creneau</label>
            <%= f.number_field :overbooking_limit_per_slot,
                  class: "input", min: 0, max: 3, step: 1 %>
          </div>

          <div>
            <label class="form-label">Capacite urgences par jour</label>
            <%= f.number_field :emergency_daily_capacity,
                  class: "input", min: 0, max: 50, step: 1 %>
          </div>

          <div style="padding-top:6px;">
            <%= link_to "Gerer les fermetures ponctuelles du cabinet",
                  company_company_closures_path,
                  class: "btn btn-ghost" %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="card">
      <div class="card-header">
        <div>
          <h3 style="font-family:var(--font-display);">🧾 Traces d'envoi des rappels</h3>
          <p style="font-size:0.82rem; color:var(--text-500); margin-top:2px;">
            Derniers envois (succes, ignore, echec) sur les canaux email, SMS et push
          </p>
        </div>
      </div>
      <div class="card-body" style="padding:0;">
        <% if @recent_reminder_deliveries.any? %>
          <div class="responsive-table-scroll">
          <table style="width:100%; border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:1px solid var(--border);">
                <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Canal</th>
                <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Statut</th>
                <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Rendez-vous</th>
                <th style="text-align:left; padding:10px 14px; font-size:0.75rem; color:var(--text-400);">Date log</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_reminder_deliveries.each do |delivery| %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:10px 14px; font-size:0.84rem;"><%= delivery.channel.upcase %></td>
                  <td style="padding:10px 14px; font-size:0.84rem;">
                    <% badge = delivery.sent? ? "badge-green" : (delivery.failed? ? "badge-red" : "badge-grey") %>
                    <span class="badge <%= badge %>"><%= delivery.status %></span>
                  </td>
                  <td style="padding:10px 14px; font-size:0.84rem; color:var(--text-500);">
                    <%= delivery.appointment.scheduled_at.strftime("%d/%m %Hh%M") %>
                  </td>
                  <td style="padding:10px 14px; font-size:0.84rem; color:var(--text-500);">
                    <%= delivery.created_at.strftime("%d/%m/%Y %Hh%M") %>
                  </td>
                </tr>
                <% if delivery.error_message.present? %>
                  <tr style="border-bottom:1px solid var(--border);">
                    <td colspan="4" style="padding:8px 14px; font-size:0.78rem; color:#b91c1c;">
                      <strong>Erreur:</strong> <%= delivery.error_message %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
          </div>
        <% else %>
          <div style="padding:14px; color:var(--text-400); font-size:0.84rem;">
            Aucune trace de rappel disponible pour le moment.
          </div>
        <% end %>
      </div>
    </div>

    <div class="responsive-form-actions" style="display:flex; justify-content:flex-end; gap:10px;">
      <%= f.submit "Sauvegarder les réglages", class: "btn btn-primary btn-lg" %>
    </div>
  </div>
<% end %>
