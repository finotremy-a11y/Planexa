<% content_for :title, t("appointments.title") %>
<% content_for :page_title, t("appointments.title") %>

<div class="mobile-action-bar" style="margin-bottom:24px;">
  <div class="mobile-action-group">
    <%= link_to t("appointments.list_view"), company_appointments_path, class: "btn btn-secondary btn-sm #{controller.action_name == 'index' ? 'active' : ''}" %>
    <%= link_to t("appointments.calendar_view"), calendar_company_appointments_path, class: "btn btn-secondary btn-sm" %>
    <%= link_to t("appointments.unassigned_view"), unassigned_company_appointments_path, class: "btn btn-secondary btn-sm" %>
  </div>
  <%= link_to t("appointments.new_short"), new_company_appointment_path, class: "btn btn-primary btn-sm" %>
</div>

<%# Search / filters %>
<%= search_form_for @q, url: company_appointments_path, html: { class: "search-form card", style: "margin-bottom:20px; padding:16px;" } do |f| %>
  <div class="filter-toolbar">
    <div class="filter-field">
      <%= f.label :status_eq, t("common.status"), style: "font-size:0.8rem; color:var(--text-400); display:block; margin-bottom:4px;" %>
      <%= f.select :status_eq,
        [[t("common.all"), nil], [t("statuses.pending"), "pending"], [t("statuses.confirmed"), "confirmed"],
         [t("statuses.cancelled"), "cancelled"], [t("statuses.completed"), "completed"], [t("statuses.no_show"), "no_show"]],
            { include_blank: false },
            class: "form-select form-select-sm" %>
    </div>
    <div class="filter-field">
      <%= f.label :scheduled_at_gteq, t("appointments.from_date"), style: "font-size:0.8rem; color:var(--text-400); display:block; margin-bottom:4px;" %>
      <%= f.date_field :scheduled_at_gteq, class: "form-control form-control-sm" %>
    </div>
    <div class="filter-field">
      <%= f.label :scheduled_at_lteq, t("appointments.to_date"), style: "font-size:0.8rem; color:var(--text-400); display:block; margin-bottom:4px;" %>
      <%= f.date_field :scheduled_at_lteq, class: "form-control form-control-sm" %>
    </div>
    <div class="filter-actions">
      <%= f.submit t("common.filter"), class: "btn btn-secondary btn-sm" %>
      <%= link_to t("common.reset"), company_appointments_path, class: "btn btn-link btn-sm" %>
    </div>
  </div>
<% end %>

<% if @appointments.any? %>
  <div class="card responsive-table-card">
    <div class="responsive-table-scroll">
    <table class="table" style="margin:0;">
      <thead>
        <tr>
          <th><%= t("appointments.date_time_header") %></th>
          <th><%= t("common.client") %></th>
          <th><%= t("common.service_type") %></th>
          <th><%= t("common.employee") %></th>
          <th><%= t("common.status") %></th>
          <th><%= t("appointments.reconfirmation") %></th>
          <th><%= t("appointments.source") %></th>
          <th style="text-align:right;"></th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appt| %>
          <tr>
            <td>
              <strong><%= appt.scheduled_at.strftime("%d/%m/%Y") %></strong><br>
              <span style="color:var(--text-400); font-size:0.85rem;"><%= appt.scheduled_at.strftime("%H:%M") %> — <%= appt.ends_at.strftime("%H:%M") %></span>
            </td>
            <td>
              <% if appt.client_user %>
                <%= appt.client_user.full_name %>
              <% else %>
                <span style="color:var(--text-400);"><%= t("appointments.client_no_account") %></span>
              <% end %>
            </td>
            <td><%= appt.service_type.name %></td>
            <td>
              <% if appt.employee %>
                <%= appt.employee.full_name %>
              <% else %>
                <span class="badge badge-warning"><%= t("appointments.unassigned_label") %></span>
              <% end %>
            </td>
            <td>
              <span class="badge badge-<%= appt.status %>">
                <%= appt.human_attribute_value(:status) rescue appt.status %>
              </span>
            </td>
            <td>
              <% if appt.reconfirmed? %>
                <span class="badge badge-green"><%= t("appointments.reconfirmation_reconfirmed") %></span>
              <% elsif appt.reconfirmation_pending? %>
                <span class="badge badge-gold"><%= t("appointments.reconfirmation_pending") %></span>
              <% else %>
                <span class="badge badge-grey"><%= t("appointments.reconfirmation_not_requested") %></span>
              <% end %>
            </td>
            <td>
              <span style="font-size:0.8rem; color:var(--text-400);">
                <%= appt.online? ? t("appointments.online") : t("appointments.manual") %>
              </span>
            </td>
            <td style="text-align:right;">
              <%= link_to t("common.view"), company_appointment_path(appt), class: "btn btn-link btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>

  <div style="margin-top:16px;">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% else %>
  <div class="empty-state">
    <div style="font-size:3rem; margin-bottom:12px;">📭</div>
    <h3><%= t("appointments.empty_state") %></h3>
    <p><%= t("appointments.empty_state_text") %></p>
    <%= link_to t("appointments.create_short"), new_company_appointment_path, class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
