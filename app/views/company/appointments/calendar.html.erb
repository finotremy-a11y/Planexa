<% content_for :title, t("appointments.calendar_title") %>
<% content_for :page_title, t("appointments.calendar_subtitle") %>

<div class="mobile-action-bar" style="margin-bottom:20px;">
  <div class="mobile-action-group">
    <%= link_to t("appointments.list_view"), company_appointments_path, class: "btn btn-secondary btn-sm" %>
    <%= link_to t("appointments.calendar_view"), calendar_company_appointments_path, class: "btn btn-secondary btn-sm active" %>
    <%= link_to t("appointments.unassigned_view"), unassigned_company_appointments_path, class: "btn btn-secondary btn-sm" %>
  </div>
  <%= link_to t("appointments.new_short"), new_company_appointment_path, class: "btn btn-primary btn-sm" %>
</div>

<%# Calendar grid for current month %>
<% today = Date.today %>
<% first_day = today.beginning_of_month %>
<% last_day  = today.end_of_month %>
<% appts_by_date = @appointments.group_by { |a| a.scheduled_at.to_date } %>

<div class="card calendar-shell" style="padding:0;">
  <%# Month header %>
  <div class="calendar-header" style="padding:16px 24px; border-bottom:1px solid var(--border);">
    <h3 style="margin:0; text-transform:capitalize;"><%= today.strftime("%B %Y") %></h3>
    <div class="mobile-action-group calendar-toolbar">
      <% prev_month = today - 1.month %>
      <% next_month = today + 1.month %>
      <%= link_to "‹", calendar_company_appointments_path(month: prev_month.month, year: prev_month.year),
            class: "btn btn-secondary btn-sm" %>
      <%= link_to t("common.today"), calendar_company_appointments_path, class: "btn btn-secondary btn-sm" %>
      <%= link_to "›", calendar_company_appointments_path(month: next_month.month, year: next_month.year),
            class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <%# Day-name headers %>
  <div class="calendar-weekdays" style="border-bottom:1px solid var(--border);">
    <% [t("employees.day_names")[1], t("employees.day_names")[2], t("employees.day_names")[3], t("employees.day_names")[4], t("employees.day_names")[5], t("employees.day_names")[6], t("employees.day_names")[0]].each do |day| %>
      <div class="calendar-weekday">
        <%= day %>
      </div>
    <% end %>
  </div>

  <%# Calendar cells %>
  <% start_cell = first_day.beginning_of_week(:monday) %>
  <% end_cell   = last_day.end_of_week(:monday) %>
  <div class="calendar-grid">
    <% (start_cell..end_cell).each do |date| %>
      <% day_appts = appts_by_date[date] || [] %>
      <% cell_classes = ["calendar-cell"] %>
      <% cell_classes << "is-today" if date == today %>
      <% cell_classes << "is-outside-month" if date.month != today.month %>
      <div class="<%= cell_classes.join(' ') %>">
        <div class="calendar-day-number <%= 'is-today' if date == today %>">
          <%= date.day %>
        </div>
        <div class="calendar-event-list">
        <% day_appts.first(3).each do |appt| %>
          <%= link_to company_appointment_path(appt),
                class: "calendar-event-link",
                title: "#{appt.service_type.name} — #{appt.scheduled_at.strftime('%H:%M')}" do %>
            <%= appt.scheduled_at.strftime("%H:%M") %> <%= appt.service_type.name %>
          <% end %>
        <% end %>
        <% if day_appts.size > 3 %>
          <span class="calendar-event-more" style="font-size:0.7rem; color:var(--text-500);">+<%= day_appts.size - 3 %> <%= t("common.more") %></span>
        <% end %>
        <% if day_appts.any? %>
          <span class="calendar-event-count"><%= pluralize(day_appts.size, 'RDV', 'RDV') %></span>
        <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# Today's list below calendar %>
<% todays_appts = appts_by_date[today] || [] %>
<% if todays_appts.any? %>
  <div class="card" style="margin-top:24px;">
    <h4 style="margin-bottom:16px;"><%= t("appointments.today_appointments") %> (<%= todays_appts.size %>)</h4>
    <% todays_appts.sort_by(&:scheduled_at).each do |appt| %>
      <div class="mobile-action-bar" style="padding:10px 0; border-bottom:1px solid var(--border);">
        <div>
          <strong><%= appt.scheduled_at.strftime("%H:%M") %></strong>
          — <%= appt.service_type.name %>
          <% if appt.employee %>
            <span style="font-size:0.85rem; color:var(--text-400);">(<%=appt.employee.full_name %>)</span>
          <% else %>
            <span class="badge badge-warning badge-sm"><%= t("appointments.unassigned_label") %></span>
          <% end %>
        </div>
        <%= link_to t("common.view"), company_appointment_path(appt), class: "btn btn-link btn-sm" %>
      </div>
    <% end %>
  </div>
<% end %>
