<% content_for :title, "Calendrier" %>
<% content_for :page_title, "Calendrier des rendez-vous" %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
  <div style="display:flex; gap:8px;">
    <%= link_to "Vue liste", company_appointments_path, class: "btn btn-secondary btn-sm" %>
    <%= link_to "Calendrier", calendar_company_appointments_path, class: "btn btn-secondary btn-sm active" %>
    <%= link_to "Non assignés", unassigned_company_appointments_path, class: "btn btn-secondary btn-sm" %>
  </div>
  <%= link_to "Nouveau RDV", new_company_appointment_path, class: "btn btn-primary btn-sm" %>
</div>

<%# Calendar grid for current month %>
<% today = Date.today %>
<% first_day = today.beginning_of_month %>
<% last_day  = today.end_of_month %>
<% appts_by_date = @appointments.group_by { |a| a.scheduled_at.to_date } %>

<div class="card" style="padding:0; overflow:hidden;">
  <%# Month header %>
  <div style="display:flex; justify-content:space-between; align-items:center; padding:16px 24px; border-bottom:1px solid var(--border);">
    <h3 style="margin:0; text-transform:capitalize;"><%= today.strftime("%B %Y") %></h3>
    <div style="display:flex; gap:8px;">
      <% prev_month = today - 1.month %>
      <% next_month = today + 1.month %>
      <%= link_to "‹", calendar_company_appointments_path(month: prev_month.month, year: prev_month.year),
            class: "btn btn-secondary btn-sm" %>
      <%= link_to "Aujourd'hui", calendar_company_appointments_path, class: "btn btn-secondary btn-sm" %>
      <%= link_to "›", calendar_company_appointments_path(month: next_month.month, year: next_month.year),
            class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <%# Day-name headers %>
  <div style="display:grid; grid-template-columns:repeat(7,1fr); border-bottom:1px solid var(--border);">
    <% %w[Lun Mar Mer Jeu Ven Sam Dim].each do |day| %>
      <div style="text-align:center; padding:8px 4px; font-size:0.78rem; font-weight:600; color:var(--text-400); text-transform:uppercase;">
        <%= day %>
      </div>
    <% end %>
  </div>

  <%# Calendar cells %>
  <% start_cell = first_day.beginning_of_week(:monday) %>
  <% end_cell   = last_day.end_of_week(:monday) %>
  <div style="display:grid; grid-template-columns:repeat(7,1fr);">
    <% (start_cell..end_cell).each do |date| %>
      <% day_appts = appts_by_date[date] || [] %>
      <div style="min-height:80px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); padding:6px;
                  background:<%= date == today ? 'rgba(5,150,105,0.04)' : 'transparent' %>;
                  opacity:<%= date.month == today.month ? '1' : '0.4' %>;">
        <div style="font-size:0.78rem; font-weight:<%= date == today ? '700' : '400' %>;
                    color:<%= date == today ? 'var(--primary)' : 'var(--text-700)' %>; margin-bottom:4px;">
          <%= date.day %>
        </div>
        <% day_appts.first(3).each do |appt| %>
          <%= link_to company_appointment_path(appt),
                style: "display:block; font-size:0.72rem; padding:2px 4px; border-radius:3px; margin-bottom:2px;
                        background:var(--primary-100,#dcfce7); color:var(--primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;",
                title: "#{appt.service_type.name} — #{appt.scheduled_at.strftime('%H:%M')}" do %>
            <%= appt.scheduled_at.strftime("%H:%M") %> <%= appt.service_type.name %>
          <% end %>
        <% end %>
        <% if day_appts.size > 3 %>
          <span style="font-size:0.7rem; color:var(--text-400);">+<%= day_appts.size - 3 %> de plus</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Today's list below calendar %>
<% todays_appts = appts_by_date[today] || [] %>
<% if todays_appts.any? %>
  <div class="card" style="margin-top:24px;">
    <h4 style="margin-bottom:16px;">Rendez-vous aujourd'hui (<%= todays_appts.size %>)</h4>
    <% todays_appts.sort_by(&:scheduled_at).each do |appt| %>
      <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border);">
        <div>
          <strong><%= appt.scheduled_at.strftime("%H:%M") %></strong>
          — <%= appt.service_type.name %>
          <% if appt.employee %>
            <span style="font-size:0.85rem; color:var(--text-400);">(<%=appt.employee.full_name %>)</span>
          <% else %>
            <span class="badge badge-warning badge-sm">Non assigné</span>
          <% end %>
        </div>
        <%= link_to "Voir", company_appointment_path(appt), class: "btn btn-link btn-sm" %>
      </div>
    <% end %>
  </div>
<% end %>
