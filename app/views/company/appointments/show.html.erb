<% content_for :title, t("appointments.show_title", id: @appointment.id) %>
<% content_for :page_title, t("appointments.show_title", id: @appointment.id) %>

<div class="detail-stack">
  <%# Main detail card %>
  <div class="card detail-main-card">
    <div class="mobile-action-bar" style="margin-bottom:20px;">
      <h3 style="margin:0;"><%= t("common.details") %></h3>
      <span class="badge badge-<%= @appointment.status %>">
        <%= @appointment.status.humanize %>
      </span>
    </div>

    <dl class="detail-definition-list">
      <dt><%= t("common.service_type") %></dt>
      <dd><strong><%= @appointment.service_type.name %></strong></dd>

      <dt><%= t("common.date") %></dt>
      <dd><%= @appointment.scheduled_at.strftime("%A %d %B %Y") %></dd>

      <dt><%= t("appointments.time_label") %></dt>
      <dd><%= @appointment.scheduled_at.strftime("%H:%M") %> → <%= @appointment.ends_at.strftime("%H:%M") %></dd>

      <dt><%= t("common.duration") %></dt>
      <dd><%= @appointment.duration_minutes %> min</dd>

      <dt><%= t("appointments.source") %></dt>
      <dd><%= @appointment.online? ? t("appointments.online_booking") : t("appointments.manual_creation") %></dd>

      <dt><%= t("appointments.reconfirmation") %></dt>
      <dd>
        <% if @appointment.reconfirmed? %>
          <span class="badge badge-green"><%= t("appointments.reconfirmation_reconfirmed") %></span>
          <span style="font-size:0.82rem; color:var(--text-400); margin-left:6px;">
            <%= @appointment.reconfirmed_at.strftime("%d/%m/%Y %Hh%M") %>
          </span>
        <% elsif @appointment.reconfirmation_pending? %>
          <span class="badge badge-gold"><%= t("appointments.reconfirmation_pending") %></span>
        <% else %>
          <span class="badge badge-grey"><%= t("appointments.reconfirmation_not_requested") %></span>
        <% end %>
      </dd>

      <% if @appointment.urgent? %>
        <dt><%= t("common.urgency") %></dt>
        <dd><span class="badge badge-danger"><%= t("appointments.urgent_label") %></span></dd>
      <% end %>
    </dl>

    <% if @appointment.client_notes.present? %>
      <hr style="margin:16px 0;">
      <h4 style="margin-bottom:8px;"><%= t("appointments.client_notes") %></h4>
      <p style="color:var(--text-500); font-size:0.9rem;"><%= @appointment.client_notes %></p>
    <% end %>

    <% if @appointment.internal_notes.present? %>
      <hr style="margin:16px 0;">
      <h4 style="margin-bottom:8px;"><%= t("appointments.internal_notes") %></h4>
      <p style="color:var(--text-500); font-size:0.9rem;"><%= @appointment.internal_notes %></p>
    <% end %>

    <hr style="margin:20px 0;">
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <% if @appointment.pending? %>
          <%= button_to t("appointments.confirm_button"), confirm_company_appointment_path(@appointment),
            method: :patch, class: "btn btn-success btn-sm",
            data: { turbo_confirm: t("appointments.confirm_confirmation") } %>
      <% end %>
      <% unless @appointment.cancelled? || @appointment.completed? %>
        <%= button_to t("appointments.mark_complete"), complete_company_appointment_path(@appointment),
              method: :patch, class: "btn btn-secondary btn-sm" %>
          <%= button_to t("common.cancel"), cancel_company_appointment_path(@appointment),
            method: :patch, class: "btn btn-danger btn-sm",
            data: { turbo_confirm: t("appointments.cancel_confirmation") },
            params: { reason: t("appointments.canceled_by_company") } %>
      <% end %>
      <%= link_to t("common.edit"), edit_company_appointment_path(@appointment), class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <%# Right column: client + employee %>
  <div class="detail-side-column">
    <%# Client %>
    <div class="card">
      <h4 style="margin-bottom:12px;"><%= t("common.client") %></h4>
      <% if @appointment.client_user %>
        <p style="margin:0;"><strong><%= @appointment.client_user.full_name %></strong></p>
        <p style="margin:4px 0; font-size:0.85rem; color:var(--text-400);"><%= @appointment.client_user.email %></p>
        <% if @conversation %>
          <%= link_to "Contacter via messagerie", company_conversation_path(@conversation), class: "btn btn-secondary btn-sm", style: "margin-top:8px;" %>
        <% end %>
      <% else %>
        <p style="color:var(--text-400); font-size:0.9rem;"><%= t("appointments.no_client_account") %></p>
      <% end %>
    </div>

    <%# Employee %>
    <div class="card">
      <h4 style="margin-bottom:12px;"><%= t("appointments.assigned_employee") %></h4>
      <% if @appointment.employee %>
        <p style="margin:0;"><strong><%= @appointment.employee.full_name %></strong></p>
        <%= link_to t("appointments.change_employee"), edit_company_appointment_path(@appointment), class: "btn btn-link btn-sm", style: "padding:0; margin-top:8px;" %>
      <% else %>
        <p style="color:var(--text-400); font-size:0.9rem; margin-bottom:12px;"><%= t("appointments.no_employee_assigned") %></p>
        <%# Quick assign form %>
        <% if @company.employees.active.any? %>
          <%= form_with url: assign_employee_company_appointment_path(@appointment), method: :patch, local: false do |f| %>
            <div class="mobile-action-group" style="align-items:center;">
              <%= f.select :employee_id,
                    @company.employees.active.map { |e| [e.full_name, e.id] },
                    { prompt: t("common.choose") },
                    class: "form-select form-select-sm", style: "flex:1;" %>
              <%= f.submit t("common.assign"), class: "btn btn-primary btn-sm" %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div style="margin-top:16px;">
  <%= link_to t("common.back_to_list"), company_appointments_path, class: "btn btn-link btn-sm" %>
</div>
