<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: 'DM Sans', Arial, sans-serif; background: #FAF8F5; margin: 0; padding: 0; }
    .email-wrapper { max-width: 560px; margin: 40px auto; }
    .email-header {
      background: #1a3d1c;
      padding: 24px 32px;
      border-radius: 12px 12px 0 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .email-logo {
      width: 32px; height: 32px;
      background: #B8860B;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: white;
    }
    .email-brand { font-size: 1.1rem; font-weight: 700; color: white; }
    .email-body { background: white; padding: 36px 32px; }
    .email-footer {
      background: #f0ede8;
      padding: 20px 32px;
      border-radius: 0 0 12px 12px;
      text-align: center;
      font-size: 0.78rem;
      color: #888;
    }
    h1 { font-size: 1.4rem; color: #1A1A1A; margin-bottom: 16px; }
    p { color: #3d3d3d; line-height: 1.7; margin-bottom: 14px; }
    .btn {
      display: inline-block;
      background: #2C5F2E;
      color: white !important;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      margin: 8px 0 20px;
    }
    .info-box {
      background: #f2f7f2;
      border-left: 4px solid #2C5F2E;
      padding: 16px 20px;
      border-radius: 0 8px 8px 0;
      margin: 20px 0;
    }
    .info-row { display: flex; gap: 12px; margin-bottom: 8px; font-size: 0.9rem; }
    .info-label { color: #6b6b6b; min-width: 120px; }
    .info-value { font-weight: 500; color: #1A1A1A; }
    .warning-box {
      background: #fdf6e3;
      border-left: 4px solid #B8860B;
      padding: 16px 20px;
      border-radius: 0 8px 8px 0;
      margin: 20px 0;
    }
    .danger-box {
      background: #fee2e2;
      border-left: 4px solid #dc2626;
      padding: 16px 20px;
      border-radius: 0 8px 8px 0;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-header">
      <div class="email-logo">⚙</div>
      <span class="email-brand">DreamAgenda</span>
    </div>
    <div class="email-body">
      <%= yield %>
    </div>
    <div class="email-footer">
      © <%= Date.current.year %> DreamAgenda — Tous droits réservés<br>
      Vous recevez cet email car vous êtes inscrit sur DreamAgenda.
    </div>
  </div>
</body>
</html>
