<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} — " : "" %>Planexa</title>
  <!-- Pas d'indexation pour l'espace entreprise -->
  <meta name="robots" content="noindex, nofollow">
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <meta name="theme-color" content="#2C5F2E">
  <!-- PWA — Progressive Web App -->
  <link rel="manifest" href="/manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Planexa">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <style>
    /* ── Company Layout ─────────────────────────────────────── */
    .company-layout {
      display: flex;
      min-height: 100vh;
      background: var(--cream);
    }

    /* Sidebar */
    .sidebar {
      width: 260px;
      background: var(--green-900);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 100;
      overflow-y: auto;
    }

    .sidebar-logo {
      padding: 28px 24px 20px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sidebar-logo-icon {
      width: 36px;
      height: 36px;
      background: var(--gold-600);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .sidebar-logo-text {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: white;
      line-height: 1.1;
    }

    .sidebar-logo-sub {
      font-size: 0.68rem;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .sidebar-company {
      padding: 16px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar-company-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: white;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sidebar-company-status {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.45);
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 2px;
    }

    .sidebar-company-status::before {
      content: '';
      width: 6px; height: 6px;
      background: #4ade80;
      border-radius: 50%;
    }

    .sidebar-nav {
      padding: 16px 0;
      flex: 1;
    }

    .sidebar-section-label {
      padding: 4px 24px 8px;
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.3);
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 24px;
      color: rgba(255,255,255,0.65);
      font-size: 0.88rem;
      font-weight: 400;
      transition: var(--transition);
      text-decoration: none;
      border-left: 3px solid transparent;
    }

    .sidebar-link:hover {
      color: white;
      background: rgba(255,255,255,0.06);
    }

    .sidebar-link.active {
      color: white;
      background: rgba(255,255,255,0.1);
      border-left-color: var(--gold-400);
      font-weight: 500;
    }

    .sidebar-link-icon {
      width: 20px;
      text-align: center;
      opacity: 0.75;
      font-size: 1rem;
    }

    .sidebar-link.active .sidebar-link-icon { opacity: 1; }

    .sidebar-badge {
      margin-left: auto;
      background: var(--gold-600);
      color: white;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 99px;
    }

    .sidebar-footer {
      padding: 16px 24px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar-user {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .sidebar-avatar {
      width: 32px; height: 32px;
      background: var(--green-700);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      font-weight: 600;
      color: white;
    }

    .sidebar-user-name {
      font-size: 0.82rem;
      font-weight: 500;
      color: white;
    }

    .sidebar-user-role {
      font-size: 0.7rem;
      color: rgba(255,255,255,0.4);
    }

    .sidebar-signout {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.45);
      text-decoration: none;
      transition: var(--transition);
    }

    .sidebar-signout:hover { color: rgba(255,255,255,0.8); }

    /* Main content */
    .main-content {
      margin-left: 260px;
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      background: white;
      border-bottom: 1px solid var(--border-light);
      padding: 0 32px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-breadcrumb {
      font-size: 0.85rem;
      color: var(--text-500);
    }

    .topbar-breadcrumb strong {
      color: var(--text-900);
      font-weight: 500;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .topbar-notification {
      width: 36px; height: 36px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-500);
      cursor: pointer;
      transition: var(--transition);
      position: relative;
    }

    .topbar-notification:hover { background: var(--cream); color: var(--text-900); }

    .content-wrapper {
      flex: 1;
      padding: 32px;
      max-width: 1200px;
      width: 100%;
    }

    /* Flash messages */
    .flash-container {
      position: fixed;
      top: 72px;
      right: 24px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-width: 380px;
    }

    .flash-message {
      padding: 14px 18px;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      font-weight: 500;
      box-shadow: var(--shadow-lg);
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to   { transform: translateX(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="company-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="sidebar-logo-icon">⚙</div>
        <div>
          <div class="sidebar-logo-text">Planexa</div>
          <div class="sidebar-logo-sub"><%= t("company_layout.space") %></div>
        </div>
      </div>

      <% if @company %>
      <div class="sidebar-company">
        <div class="sidebar-company-name"><%= @company.name %></div>
        <div class="sidebar-company-status">
          <%= @company.trial_active? ? t("company_layout.trial") : t("company_layout.subscription_active") %>
        </div>
      </div>
      <% end %>

      <nav class="sidebar-nav">
        <div class="sidebar-section-label"><%= t("company_layout.section_main") %></div>

        <%= link_to company_root_path,
              class: "sidebar-link #{current_page?(company_root_path) ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">◈</span>
          <%= t("company_layout.dashboard") %>
        <% end %>

        <%= link_to company_appointments_path,
              class: "sidebar-link #{controller_name == 'appointments' && controller_path.start_with?('company/') ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">📅</span>
          <%= t("company_layout.appointments") %>
          <% unassigned = @company&.appointments&.pending&.unassigned&.count || 0 %>
          <% if unassigned > 0 %>
            <span class="sidebar-badge"><%= unassigned %></span>
          <% end %>
        <% end %>

        <div class="sidebar-section-label" style="margin-top:12px"><%= t("company_layout.section_team") %></div>

        <%= link_to company_employees_path,
              class: "sidebar-link #{controller_name == 'employees' ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">👥</span>
          <%= t("company_layout.employees") %>
        <% end %>

        <%= link_to company_service_types_path,
              class: "sidebar-link #{controller_name == 'service_types' ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">🔧</span>
          <%= t("company_layout.service_types") %>
        <% end %>

        <%= link_to company_reviews_path,
              class: "sidebar-link #{controller_name == 'reviews' && controller_path.start_with?('company/') ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">⭐</span>
          <%= t("company_layout.reviews") %>
        <% end %>

          <%= link_to company_inactive_clients_path,
            class: "sidebar-link #{controller_name == 'inactive_clients' && controller_path.start_with?('company/') ? 'active' : ''}" do %>
            <span class="sidebar-link-icon">📣</span>
            <%= t("company_layout.inactive_clients") %>
          <% end %>

        <%= link_to company_waitlist_entries_path,
              class: "sidebar-link #{controller_name == 'waitlist_entries' && controller_path.start_with?('company/') ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">📋</span>
          <%= t("company_layout.waitlist") %>
          <% waitlist_pending = @company&.waitlist_entries&.pending&.count || 0 %>
          <% if waitlist_pending > 0 %>
            <span class="sidebar-badge"><%= waitlist_pending %></span>
          <% end %>
        <% end %>

        <div class="sidebar-section-label" style="margin-top:12px"><%= t("company_layout.section_configuration") %></div>

        <%= link_to company_settings_path,
              class: "sidebar-link #{controller_name == 'settings' ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">⚙</span>
          <%= t("company_layout.settings") %>
        <% end %>

        <%= link_to company_subscription_path,
              class: "sidebar-link #{controller_name == 'subscriptions' ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">💳</span>
          <%= t("company_layout.subscription") %>
        <% end %>

        <%= link_to company_invoices_path,
              class: "sidebar-link #{controller_name == 'invoices' && controller_path.start_with?('company/') ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">🧾</span>
          <%= t("company_layout.invoices") %>
        <% end %>

        <%= link_to company_profile_path,
              class: "sidebar-link #{controller_name == 'profiles' ? 'active' : ''}" do %>
          <span class="sidebar-link-icon">🏢</span>
          <%= t("company_layout.company_profile") %>
        <% end %>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="sidebar-avatar">
            <%= current_user.first_name[0].upcase %><%= current_user.last_name[0].upcase %>
          </div>
          <div>
            <div class="sidebar-user-name"><%= current_user.full_name %></div>
            <div class="sidebar-user-role"><%= t("company_layout.administrator") %></div>
          </div>
        </div>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
              class: "sidebar-signout" do %>
          ↩ <%= t("nav.sign_out") %>
        <% end %>
      </div>
    </aside>

    <!-- Main content -->
    <div class="main-content">
      <header class="topbar">
        <div class="topbar-breadcrumb">
          <%= t("company_layout.breadcrumb_prefix") %> /
          <strong><%= yield(:page_title) || controller_name.humanize %></strong>
        </div>
        <div class="topbar-actions">
          <%= render "shared/locale_switcher" %>
          <%# ── Cloche de notifications temps réel ── %>
          <% if @company %>
            <%= turbo_stream_from "company_#{@company.id}_notifications" %>
            <div style="position:relative;" data-controller="notifications">
              <button data-action="click->notifications#toggle"
                      class="topbar-notification"
                      title="<%= t('company_layout.notifications') %>"
                      style="position:relative;">
                🔔
                <%= render "company/notifications/badge",
                      count: @company.notifications.unread.count %>
              </button>
              <div data-notifications-target="dropdown"
                   style="display:none; position:absolute; top:44px; right:0;
                          width:320px; background:white; border:1px solid var(--border);
                          border-radius:var(--radius-md); box-shadow:var(--shadow-lg);
                          z-index:300; overflow:hidden;">
                <div style="padding:10px 14px; border-bottom:1px solid var(--border-light);
                             display:flex; align-items:center; justify-content:space-between;">
                  <strong style="font-size:0.875rem;"><%= t("company_layout.notifications") %></strong>
                  <%= link_to t("company_layout.see_all"),
                        company_notifications_path,
                        style: "font-size:0.78rem; color:var(--green-700);" %>
                </div>
                <div id="notifications_list" style="max-height:320px; overflow-y:auto;">
                  <% recent = @company.notifications.recent %>
                  <% if recent.empty? %>
                    <p style="padding:24px; text-align:center; color:var(--text-400);
                               font-size:0.875rem; margin:0;"><%= t("company_layout.no_notifications") %></p>
                  <% else %>
                    <% recent.each do |n| %>
                      <%= render "company/notifications/notification", notification: n %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          <%= link_to root_path, class: "btn btn-ghost btn-sm", target: "_blank" do %>
            👁 <%= t("company_layout.view_public_page") %>
          <% end %>
        </div>
      </header>

      <!-- Flash messages -->
      <div class="flash-container">
        <% flash.each do |type, message| %>
          <% css = { "notice" => "alert-success", "alert" => "alert-error",
                     "warning" => "alert-warning", "info" => "alert-info" } %>
          <div class="flash-message alert <%= css[type] || 'alert-info' %>"
               data-controller="flash">
            <%= message %>
          </div>
        <% end %>
      </div>

      <div class="content-wrapper">
        <%= yield %>
      </div>
    </div>
  </div>

  <!-- PWA Initialization -->
  <script type="module">
    import { initPWA } from '/assets/pwa/register.js';
    initPWA();
  </script>
</body>
</html>
