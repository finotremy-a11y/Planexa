<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Titre dynamique -->
  <title><%= content_for?(:title) ? page_title(yield(:title)) : page_title %></title>

  <!-- Meta description -->
  <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : default_meta_description %>">

  <!-- Robots -->
  <meta name="robots" content="<%= content_for?(:robots) ? yield(:robots) : 'index, follow' %>">

  <!-- Canonical -->
  <% if content_for?(:canonical) %>
    <link rel="canonical" href="<%= yield(:canonical) %>">
  <% end %>

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="Planexa">
  <meta property="og:title"       content="<%= content_for?(:title) ? page_title(yield(:title)) : page_title %>">
  <meta property="og:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : default_meta_description %>">
  <meta property="og:image"       content="<%= content_for?(:og_image) ? yield(:og_image) : og_image_url %>">
  <meta property="og:url"         content="<%= request.original_url %>">
  <meta property="og:locale"      content="<%= I18n.locale == :fr ? 'fr_FR' : (I18n.locale == :es ? 'es_ES' : 'en_US') %>">

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="<%= content_for?(:title) ? page_title(yield(:title)) : page_title %>">
  <meta name="twitter:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : default_meta_description %>">
  <meta name="twitter:image"       content="<%= content_for?(:og_image) ? yield(:og_image) : og_image_url %>">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <meta name="theme-color" content="#2C5F2E">

  <!-- PWA — Progressive Web App -->
  <link rel="manifest" href="/manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Planexa">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <style>
    .navbar {
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-light);
      padding: 0 40px;
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }

    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .navbar-logo {
      width: 32px; height: 32px;
      background: var(--green-800);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
    }

    .navbar-brand-name {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-900);
    }

    .navbar-links {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .navbar-hamburger {
      display: none;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border: 1px solid var(--border);
      background: white;
      border-radius: var(--radius-md);
      color: var(--text-900);
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
    }

    .navbar-link {
      padding: 8px 16px;
      font-size: 0.88rem;
      color: var(--text-700);
      font-weight: 500;
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .navbar-link:hover {
      background: var(--cream);
      color: var(--text-900);
    }

    .public-footer {
      background: linear-gradient(180deg, var(--green-900) 0%, #122c14 100%);
      color: rgba(255,255,255,0.6);
      padding: 44px 40px 24px;
      margin-top: 80px;
    }

    .public-footer a { color: rgba(255,255,255,0.68); }
    .public-footer strong { color: white; }

    .public-footer-grid {
      max-width: 1100px;
      margin: 0 auto 32px;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }

    .public-footer-heading {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.35);
      margin-bottom: 12px;
    }

    .public-footer-links {
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 0.85rem;
    }

    .public-footer-bottom {
      max-width: 1100px;
      margin: 0 auto;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.78rem;
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 14px 20px;
        position: relative;
      }

      .navbar-links {
        position: absolute;
        top: calc(100% + 8px);
        left: 20px;
        right: 20px;
        width: auto;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        justify-content: flex-start;
        background: white;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-lg);
        padding: 10px;
        z-index: 110;
      }

      .navbar-links.open {
        display: flex;
      }

      .navbar-hamburger {
        display: inline-flex;
      }

      .navbar-link,
      .navbar-links .btn {
        width: 100%;
        justify-content: center;
      }

      .public-footer {
        padding: 36px 20px 22px;
      }

      .public-footer-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <%= link_to root_path, class: "navbar-brand" do %>
      <div class="navbar-logo">⚙</div>
      <span class="navbar-brand-name">Planexa</span>
    <% end %>

    <button class="navbar-hamburger" id="navbarHamburger" aria-label="Menu" aria-expanded="false">
      ☰
    </button>

    <div class="navbar-links" id="navbarLinks">
      <%= render "shared/locale_switcher" %>
      <%= link_to t("nav.search"), search_path, class: "navbar-link" %>
      <%= link_to "Tarifs", tarifs_path, class: "navbar-link" %>
      <%= link_to t("nav.contact"), contact_path, class: "navbar-link" %>

      <% if user_signed_in? %>
        <% case current_user.role %>
        <% when "company_admin" %>
          <%= link_to t("nav.my_dashboard"), company_root_path, class: "btn btn-secondary btn-sm" %>
        <% when "client" %>
          <%= link_to t("nav.my_appointments"), client_root_path, class: "btn btn-secondary btn-sm" %>
        <% when "admin" %>
          <%= link_to t("nav.admin"), admin_root_path, class: "btn btn-secondary btn-sm" %>
        <% end %>

        <details style="position:relative;">
          <summary style="display:flex; align-items:center; gap:6px; background:var(--cream);
                          border:1.5px solid var(--border); border-radius:var(--radius-md);
                          padding:6px 12px; cursor:pointer; font-family:var(--font-body);
                          font-size:0.85rem; font-weight:500; list-style:none;"
                   aria-label="Menu utilisateur">
            <div style="width:26px; height:26px; background:var(--green-800); border-radius:50%;
                        display:flex; align-items:center; justify-content:center;
                        font-size:0.7rem; font-weight:700; color:white;">
              <%= avatar_initials(current_user.full_name) %>
            </div>
            <%= current_user.first_name %>
            ▾
          </summary>

          <div style="position:absolute; right:0; top:calc(100% + 6px);
                      background:white; border:1px solid var(--border-light);
                      border-radius:var(--radius-md); box-shadow:var(--shadow-lg);
                      min-width:180px; z-index:200; overflow:hidden;">
            <%= link_to t("nav.sign_out"), destroy_user_session_path,
                  data: { turbo_method: :delete },
                  style: "display:block; padding:10px 16px; font-size:0.88rem; color:#dc2626; text-decoration:none;" %>
          </div>
        </details>
      <% else %>
        <%= link_to t("nav.sign_in"), new_user_session_path, class: "navbar-link" %>
        <%= link_to t("nav.free_trial"), new_user_registration_path,
              class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </nav>

  <% flash.each do |type, message| %>
    <% css = { "notice" => "alert-success", "alert" => "alert-error" } %>
    <div class="alert <%= css[type] || 'alert-info' %>"
         style="margin:16px auto; max-width:720px; border-radius:var(--radius-md);">
      <%= message %>
    </div>
  <% end %>

  <%= yield %>

  <footer class="public-footer">
    <div class="public-footer-grid">
      <div>
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
          <div style="width:28px; height:28px; background:var(--gold-600); border-radius:4px;
                      display:flex; align-items:center; justify-content:center; font-size:0.85rem;">⚙</div>
          <span style="font-family:var(--font-display); font-size:1rem; font-weight:700; color:white;">Planexa</span>
        </div>
        <p style="font-size:0.82rem; line-height:1.7; max-width:300px; color:rgba(255,255,255,0.6);">
          <%= t("footer.description") %>
        </p>
      </div>

      <div>
        <div class="public-footer-heading"><%= t("footer.legal") %></div>
        <div class="public-footer-links">
          <%= link_to t("footer.legal_notice"), mentions_legales_path %>
          <%= link_to t("footer.terms_of_use"), cgu_path %>
          <%= link_to t("footer.terms_of_sale"), cgv_path %>
          <%= link_to t("footer.privacy"), confidentialite_path %>
        </div>
      </div>

      <div>
        <div class="public-footer-heading">Planexa</div>
        <div class="public-footer-links">
          <%= link_to t("nav.search"), search_path %>
          <%= link_to t("nav.contact"), contact_path %>
          <% unless user_signed_in? %>
            <%= link_to t("footer.create_company_account"), new_user_registration_path %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="public-footer-bottom">
      <span><%= t("footer.copyright", year: Date.current.year, business: legal_business_name) %></span>
      <span><%= t("footer.made_in_france") %></span>
    </div>
  </footer>

  <!-- PWA Initialization -->
  <script type="module">
    import { initPWA } from '/assets/pwa/register.js';
    // Initialize PWA features if user is online and has JS enabled
    initPWA();
  </script>
  <script>
    (function () {
      function initPublicHamburger() {
        var button = document.getElementById('navbarHamburger');
        var links = document.getElementById('navbarLinks');
        if (!button || !links) return;
        if (button.dataset.hamburgerBound === 'true') return;
        button.dataset.hamburgerBound = 'true';

        button.addEventListener('click', function (event) {
          event.stopPropagation();
          var isOpen = links.classList.toggle('open');
          button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        document.addEventListener('click', function (event) {
          if (!links.classList.contains('open')) return;
          if (button.contains(event.target) || links.contains(event.target)) return;
          links.classList.remove('open');
          button.setAttribute('aria-expanded', 'false');
        });
      }

      document.addEventListener('turbo:load', initPublicHamburger);
      document.addEventListener('DOMContentLoaded', initPublicHamburger);
    })();
  </script>
</body>
</html>
