<% content_for :title, "Réservation multi-prestation" %>

<div style="max-width:680px; margin:40px auto; padding:0 24px;">
  <div style="margin-bottom:24px;">
    <h1 style="font-family:var(--font-display); margin-bottom:4px;">
      Réserver plusieurs prestations
    </h1>
    <p style="color:var(--text-500);">
      <%= link_to @company.name, company_public_path(@company),
            style: "color:var(--green-700); font-weight:500;" %>
    </p>
  </div>

  <%= form_with model: @booking_group, url: bookings_path(company_id: @company.id), local: true do |f| %>
    <div class="card">
      <div class="card-body">
        <% if @errors&.any? %>
          <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:var(--radius-md);
                      padding:12px 16px; margin-bottom:20px; color:#dc2626;">
            <% @errors.each do |msg| %>
              <div>&bull; <%= msg %></div>
            <% end %>
          </div>
        <% end %>

        <%# ── Étape 1 : Sélection des prestations ── %>
        <div class="form-group">
          <label class="form-label">Sélectionnez vos prestations (minimum 2)</label>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <% @service_types.each do |st| %>
              <label class="service-option-row" style="display:flex; align-items:center; justify-content:space-between;
                             padding:12px 16px; border:2px solid var(--border);
                             border-radius:var(--radius-md); cursor:pointer;">
                <div class="service-option-main" style="display:flex; align-items:center; gap:10px;">
                  <%= check_box_tag "booking_group[service_type_ids][]", st.id, false,
                        id: "service_type_#{st.id}" %>
                  <div>
                    <div style="font-weight:500;"><%= st.name %></div>
                    <div style="font-size:0.78rem; color:var(--text-300);">
                      ⏱ <%= st.duration_minutes %> min
                    </div>
                  </div>
                </div>
                <% if st.price_cents > 0 %>
                  <div class="service-option-price" style="font-weight:600; color:var(--green-800);">
                    <%= number_to_currency(st.price_cents / 100.0, unit: "€", separator: ",",
                          delimiter: " ", format: "%n %u") %>
                  </div>
                <% end %>
              </label>
            <% end %>
          </div>
        </div>

        <%# ── Étape 2 : Date et heure ── %>
        <div class="form-group">
          <%= f.label :scheduled_at, "Date et heure souhaitées", class: "form-label" %>
          <%= f.datetime_local_field :scheduled_at, class: "form-control",
                min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
          <p style="font-size:0.8rem; color:var(--text-400); margin-top:4px;">
            Les prestations seront enchaînées automatiquement à partir de ce créneau.
          </p>
        </div>

        <%# ── Étape 3 : Notes ── %>
        <div class="form-group">
          <%= f.label :client_notes, "Message (optionnel)", class: "form-label" %>
          <%= f.text_area :client_notes, class: "form-control",
                placeholder: "Décrivez votre besoin, informations utiles...", rows: 3 %>
        </div>
      </div>

      <div class="responsive-form-actions" style="padding:16px 24px; border-top:1px solid var(--border);
                  display:flex; gap:10px; justify-content:space-between; align-items:center;">
        <%= link_to "← Retour", company_public_path(@company), class: "btn btn-secondary" %>
        <div class="responsive-wrap" style="display:flex; gap:10px; align-items:center;">
          <%= link_to "RDV simple", new_appointment_path(company_id: @company.id),
                style: "color:var(--text-400); font-size:0.85rem;" %>
          <%= f.submit "Confirmer la réservation →", class: "btn btn-primary btn-lg" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
