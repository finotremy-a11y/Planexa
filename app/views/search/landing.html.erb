<% content_for :title, t("search.landing.meta.title", activity: @activity.titleize, city: @city.titleize) %>
<% content_for :meta_description do %><%= t("search.landing.meta.description", activity: @activity.downcase, city: @city.titleize) %><% end %>
<% content_for :canonical, seo_search_landing_url(activity_slug: @activity.parameterize, city_slug: @city.parameterize) %>

<div style="background:linear-gradient(135deg, #0f3a20, #1f6b3c); padding:52px 28px 38px; color:white;">
  <div style="max-width:1000px; margin:0 auto;">
    <p style="text-transform:uppercase; letter-spacing:0.08em; font-size:0.74rem; opacity:0.7; margin-bottom:10px;">
      <%= t("search.landing.kicker") %>
    </p>
    <h1 style="font-family:var(--font-display); font-size:2rem; margin:0 0 10px 0;">
      <%= t("search.landing.heading", activity: @activity.titleize, city: @city.titleize) %>
    </h1>
    <p style="max-width:700px; margin:0; color:rgba(255,255,255,0.82); line-height:1.7;">
      <%= t("search.landing.intro", activity: @activity.downcase, city: @city.titleize) %>
    </p>
  </div>
</div>

<div class="responsive-aside-grid" style="max-width:1100px; margin:30px auto; padding:0 24px; display:grid; grid-template-columns:2fr 1fr; gap:24px; align-items:start;">
  <section>
    <% if @companies.any? %>
      <p style="font-size:0.9rem; color:var(--text-500); margin:0 0 16px 0;">
        <%= t("search.landing.results_count", count: @pagy.count, activity: @activity.downcase, city: @city.titleize) %>
      </p>

      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:16px;">
        <% @companies.each do |company| %>
          <article class="card" style="height:100%;">
            <div class="card-body" style="display:flex; flex-direction:column; gap:12px;">
              <div style="display:flex; align-items:flex-start; gap:10px;">
                <div style="width:46px; height:46px; background:var(--green-100); border-radius:10px;
                            display:flex; align-items:center; justify-content:center; font-weight:700;
                            color:var(--green-800); font-family:var(--font-display); flex-shrink:0;">
                  <%= company.name[0].upcase %>
                </div>
                <div>
                  <h2 style="font-size:1rem; margin:0 0 4px 0;"><%= company.name %></h2>
                  <p style="font-size:0.82rem; color:var(--text-500); margin:0;">📍 <%= company.city %></p>
                  <% stats = @company_review_stats[company.id] %>
                  <% if stats.present? && stats[:review_count].positive? %>
                    <p style="font-size:0.78rem; color:var(--text-500); margin:4px 0 0 0;">
                      ★ <strong style="color:#b7791f;"><%= stats[:avg_rating] %></strong>
                      · <%= t("search.results.reviews_count", count: stats[:review_count]) %>
                    </p>
                  <% end %>
                </div>
              </div>

              <% if company.description.present? %>
                <p style="font-size:0.84rem; color:var(--text-600); margin:0; line-height:1.6;">
                  <%= truncate(company.description, length: 120) %>
                </p>
              <% end %>

              <div style="display:flex; flex-wrap:wrap; gap:6px;">
                <% company.service_types.active.limit(4).each do |service| %>
                  <span style="background:var(--green-50); color:var(--green-800); border:1px solid var(--green-200);
                                font-size:0.72rem; padding:3px 8px; border-radius:99px;">
                    <%= service.name %>
                  </span>
                <% end %>
              </div>

              <%= link_to t("search.landing.cta_book"),
                    company_public_path(company),
                    class: "btn btn-primary",
                    style: "justify-content:center; width:100%; margin-top:auto;" %>
            </div>
          </article>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div style="margin-top:24px;">
          <%== pagy_bootstrap_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="card">
        <div style="padding:40px 28px; text-align:center;">
          <h2 style="margin-top:0;"><%= t("search.landing.no_results.title") %></h2>
          <p style="color:var(--text-500); max-width:550px; margin:0 auto 16px; line-height:1.7;">
            <%= t("search.landing.no_results.description", activity: @activity.downcase, city: @city.titleize) %>
          </p>
          <%= link_to t("search.landing.no_results.back_search"), search_path(activity: @activity, city: @city), class: "btn btn-secondary" %>
        </div>
      </div>
    <% end %>
  </section>

  <aside>
    <div class="card" style="position:sticky; top:84px;">
      <div style="padding:16px 20px; border-bottom:1px solid var(--border);">
        <h3 style="margin:0; font-family:var(--font-display);"><%= t("search.landing.guide.title") %></h3>
      </div>
      <div style="padding:16px 20px; display:flex; flex-direction:column; gap:10px;">
        <p style="font-size:0.84rem; color:var(--text-600); margin:0;"><%= t("search.landing.guide.tip_1") %></p>
        <p style="font-size:0.84rem; color:var(--text-600); margin:0;"><%= t("search.landing.guide.tip_2") %></p>
        <p style="font-size:0.84rem; color:var(--text-600); margin:0;"><%= t("search.landing.guide.tip_3") %></p>

        <% if @popular_services.any? %>
          <hr style="border:none; border-top:1px solid var(--border); margin:8px 0;">
          <p style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-400); margin:0;">
            <%= t("search.landing.related_services") %>
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:6px;">
            <% @popular_services.each do |service_name| %>
              <%= link_to service_name,
                    seo_search_landing_path(activity_slug: service_name.parameterize, city_slug: @city.parameterize),
                    style: "font-size:0.72rem; background:var(--cream); color:var(--text-700); padding:3px 8px; border-radius:999px; border:1px solid var(--border); text-decoration:none;" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </aside>
</div>
