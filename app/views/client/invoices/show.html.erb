<% content_for :title, t("invoices.show_title", number: @invoice.invoice_number) %>

<div class="page-header">
  <div class="page-header-left">
    <h1><%= t("invoices.show_title", number: @invoice.invoice_number) %></h1>
    <p><%= @invoice.company.name %> — <%= t("invoices.issued_date", date: @invoice.issued_at.strftime("%d/%m/%Y")) %></p>
  </div>
  <div class="page-header-actions" style="display:flex; gap:8px;">
    <% if @invoice.pdf.attached? %>
      <%= link_to "⬇ #{t("invoices.download_pdf")}", download_client_invoice_path(@invoice), class: "btn btn-primary btn-sm" %>
    <% end %>
    <%= link_to t("invoices.back_to_list"), client_invoices_path, class: "btn btn-secondary btn-sm" %>
  </div>
</div>

<div class="card" style="max-width:700px;">
  <div style="padding:32px;">
    <%# En-tête entreprise %>
    <div style="margin-bottom:24px;">
      <div style="font-size:1.2rem; font-weight:700; color:var(--green-800);"><%= @invoice.company.name %></div>
      <div style="font-size:0.85rem; color:var(--text-400); margin-top:4px;">
        <%= @invoice.company.address %><br>
        <%= @invoice.company.zip_code %> <%= @invoice.company.city %><br>
        <%= t("common.siret") %> : <%= @invoice.company.siret %>
      </div>
    </div>

    <hr style="border:none; border-top:1px solid var(--border); margin:20px 0;">

    <%# Titre facture %>
    <div style="text-align:right; margin-bottom:24px;">
      <div style="font-size:1.1rem; font-weight:700;"><%= t("invoices.invoice_number_label") %> <%= @invoice.invoice_number %></div>
      <div style="font-size:0.85rem; color:var(--text-400);">
        <%= t("invoices.issued_date", date: @invoice.issued_at.strftime("%d/%m/%Y")) %>
      </div>
      <% if @invoice.payment&.appointment %>
        <div style="font-size:0.85rem; color:var(--text-400);">
          <%= t("invoices.appointment_date", date: @invoice.payment.appointment.scheduled_at.strftime("%d/%m/%Y")) %>
        </div>
      <% end %>
    </div>

    <%# Client %>
    <div style="margin-bottom:24px;">
      <div style="font-size:0.75rem; font-weight:600; color:var(--text-300); text-transform:uppercase; letter-spacing:0.05em;"><%= t("invoices.billed_to") %></div>
      <div style="margin-top:6px;">
        <div style="font-weight:600;"><%= current_user.full_name %></div>
        <div style="font-size:0.85rem; color:var(--text-400);"><%= current_user.email %></div>
      </div>
    </div>

    <hr style="border:none; border-top:1px solid var(--border); margin:20px 0;">

    <%# Service %>
    <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
      <thead>
        <tr style="background:var(--bg-secondary);">
          <th style="padding:10px 12px; text-align:left; font-size:0.82rem; color:var(--text-400); font-weight:600;"><%= t("invoices.description_header") %></th>
          <th style="padding:10px 12px; text-align:right; font-size:0.82rem; color:var(--text-400); font-weight:600;"><%= t("invoices.amount_ht") %></th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:12px;">
            <%= @invoice.payment&.appointment&.service_type&.name || t("invoices.service_label") %>
          </td>
          <td style="padding:12px; text-align:right;">
            <%= number_to_currency(@invoice.subtotal_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
          </td>
        </tr>
      </tbody>
    </table>

    <%# Totaux %>
    <div style="text-align:right;">
      <div style="font-size:0.88rem; color:var(--text-500); margin-bottom:4px;">
        <%= t("invoices.subtotal_ht") %>
        <%= number_to_currency(@invoice.subtotal_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      </div>
      <div style="font-size:0.88rem; color:var(--text-500); margin-bottom:8px;">
        <%= t("invoices.tax_label") %> <%= (@invoice.tax_rate * 100).to_i %>% :
        <%= number_to_currency(@invoice.tax_amount_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      </div>
      <div style="font-size:1.1rem; font-weight:700; color:var(--green-800);">
        <%= t("invoices.total_ttc") %>
        <%= number_to_currency(@invoice.total_cents / 100.0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      </div>
    </div>

    <hr style="border:none; border-top:1px solid var(--border); margin:24px 0 16px;">

    <div style="font-size:0.75rem; color:var(--text-300); text-align:center;">
      <%= t("invoices.payment_notice") %>
    </div>
  </div>
</div>
