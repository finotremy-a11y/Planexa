<!-- app/views/client/push_settings/index.html.erb -->
<!-- Paramètres de notifications push pour l'utilisateur -->

<div class="client-section">
  <div class="section-header">
    <h2>🔔 Notifications</h2>
    <p>Gérez vos préférences de notifications push</p>
  </div>

  <div class="notification-card">
    <div class="notification-status">
      <% if user_has_push_subscriptions?(@user) %>
        <div class="status-badge badge-enabled">
          ✓ Notifications activées
        </div>
        <p class="status-text">
          Vous recevrez des notifications pour les nouveaux rendez-vous, rappels et mises à jour importantes.
        </p>
      <% else %>
        <div class="status-badge badge-disabled">
          ✗ Notifications désactivées
        </div>
        <p class="status-text">
          <%= link_to "Activer les notifications push", "#", class: "btn btn-sm btn-primary" %>
        </p>
      <% end %>
    </div>
  </div>

  <!-- Type de notifications -->
  <div class="notification-preferences">
    <h3>Types de notifications</h3>

    <div class="preference-group">
      <label class="preference-item">
        <input type="checkbox" checked="checked" disabled="disabled" />
        <div>
          <strong>Nouvelles réservations</strong>
          <p>Confirmé quand un RDV est confirmé</p>
        </div>
      </label>

      <label class="preference-item">
        <input type="checkbox" checked="checked" disabled="disabled" />
        <div>
          <strong>Rappels de rendez-vous</strong>
          <p>Rappel 24h avant et 1h avant votre RDV</p>
        </div>
      </label>

      <label class="preference-item">
        <input type="checkbox" checked="checked" disabled="disabled" />
        <div>
          <strong>Paiements reçus</strong>
          <p>Confirmation quand nous recevons votre paiement</p>
        </div>
      </label>

      <label class="preference-item">
        <input type="checkbox" checked="checked" disabled="disabled" />
        <div>
          <strong>Annulations</strong>
          <p>Notification si un RDV est annulé</p>
        </div>
      </label>
    </div>
  </div>

  <!-- Appareils -->
  <div class="registered-devices">
    <h3>Appareils enregistrés</h3>

    <% if @user.push_subscriptions.any? %>
      <table class="devices-table">
        <thead>
          <tr>
            <th>Appareil</th>
            <th>Enregistré le</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @user.push_subscriptions.each do |sub| %>
            <tr>
              <td>
                <% if sub.endpoint.include?("fcm") %>
                  📱 Navigateur (Android/FCM)
                <% elsif sub.endpoint.include?("edge-") %>
                  🔷 Microsoft Edge
                <% elsif sub.endpoint.include?("mozilla") %>
                  🦊 Firefox
                <% else %>
                  💻 Navigateur
                <% end %>
              </td>
              <td><%= time_ago_in_words(sub.created_at) %> ago</td>
              <td>
                <%= button_to "Supprimer",
                              api_v1_push_subscription_path(sub),
                              method: :delete,
                              data: { confirm: "Êtes-vous sûr ?" },
                              class: "btn btn-sm btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state">
        Aucun appareil enregistré. Activez les notifications pour commencer.
      </p>
    <% end %>
  </div>

  <!-- Installation PWA -->
  <div class="pwa-install-section">
    <h3>📲 Installer l'app</h3>
    <p>Installez DreamAgenda sur votre écran d'accueil pour un accès rapide et hors ligne.</p>
    <div class="pwa-instructions">
      <div class="browser-instruction">
        <strong>Sur Chrome/Edge :</strong> Appuyez sur l'icône d'installation (carré+flèche) dans la barre d'adresse
      </div>
      <div class="browser-instruction">
        <strong>Sur iOS :</strong> Ouvrez le menu (partage), puis "Sur l'écran d'accueil"
      </div>
      <div class="browser-instruction">
        <strong>Sur Samsung :</strong> Appuyez sur le bouton menu, puis "App install"
      </div>
    </div>
  </div>
</div>

<style>
  .notification-card {
    background: linear-gradient(135deg, #f0f9ff 0%, #f3f4f6 100%);
    border: 1px solid #dbeafe;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .badge-enabled {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #6ee7b7;
  }

  .badge-disabled {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .status-text {
    color: #4b5563;
    margin: 0;
  }

  .notification-preferences {
    margin: 2rem 0;
  }

  .notification-preferences h3 {
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .preference-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .preference-item {
    display: flex;
    align-items: flex-start;
    padding: 1rem;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preference-item:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .preference-item input {
    margin-right: 1rem;
    margin-top: 0.25rem;
  }

  .preference-item div strong {
    display: block;
    color: #1f2937;
    margin-bottom: 0.25rem;
  }

  .preference-item div p {
    color: #6b7280;
    font-size: 0.875rem;
    margin: 0;
  }

  .registered-devices {
    margin: 2rem 0;
  }

  .registered-devices h3 {
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .devices-table {
    width: 100%;
    border-collapse: collapse;
  }

  .devices-table thead {
    background: #f3f4f6;
    border-bottom: 2px solid #e5e7eb;
  }

  .devices-table th {
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
    color: #1f2937;
  }

  .devices-table td {
    padding: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .pwa-install-section {
    background: #fef3c7;
    border: 1px solid #f59e0b;
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 2rem;
  }

  .pwa-install-section h3 {
    color: #92400e;
    margin-top: 0;
  }

  .pwa-instructions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .browser-instruction {
    background: white;
    border-left: 4px solid #f59e0b;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    color: #5a4a00;
    font-size: 0.875rem;
  }

  .empty-state {
    color: #6b7280;
    font-style: italic;
    padding: 2rem;
    text-align: center;
  }
</style>
