<% content_for :title, "Messagerie" %>

<div style="max-width:980px; margin:30px auto; padding:0 20px;">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px; flex-wrap:wrap;">
    <div>
      <h1 style="margin:0;">Discussion avec <%= @conversation.company.name %></h1>
      <p style="margin:4px 0 0 0; color:var(--text-500); font-size:0.9rem;">Echanges en temps reel entre vous et l'entreprise.</p>
    </div>
    <%= link_to "Toutes les conversations", client_conversations_path, class: "btn btn-secondary btn-sm" %>
  </div>

  <%= turbo_stream_from @conversation.stream_name %>

  <div class="card" style="padding:0; overflow:hidden;">
    <div id="messages_list" style="padding:14px; max-height:60vh; overflow-y:auto; background:linear-gradient(180deg, #fcfdf9 0%, #ffffff 30%);">
      <% if @messages.empty? %>
        <p style="color:var(--text-400); margin:4px 0;">Aucun message pour le moment.</p>
      <% else %>
        <%= render @messages %>
      <% end %>
    </div>

    <div style="padding:14px; border-top:1px solid var(--border-light); background:white;">
      <%= render "form", conversation: @conversation, message: @message %>
    </div>
  </div>
</div>
