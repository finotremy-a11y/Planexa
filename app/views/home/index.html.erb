<%#
<style>
  .hero {
    background: linear-gradient(135deg, var(--green-900) 0%, var(--green-800) 60%, var(--brown-700) 100%);
    padding: 80px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-content { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.9);
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 0.82rem;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: white;
    margin-bottom: 20px;
    line-height: 1.15;
  }

  .hero p {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.75);
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  .btn-white {
    background: white;
    color: var(--green-800);
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    transition: var(--transition);
    text-decoration: none;
  }

  .btn-white:hover {
    background: var(--cream);
    color: var(--green-800);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }

  .btn-outline-white {
    background: transparent;
    color: white;
    border: 2px solid rgba(255,255,255,0.5);
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    transition: var(--transition);
    text-decoration: none;
  }

  .btn-outline-white:hover {
    border-color: white;
    background: rgba(255,255,255,0.1);
    color: white;
  }
</style>

<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">⚙ Pour les artisans et pros</div>
    <h1>Gérez vos rendez-vous comme un pro</h1>
    <p>Planning en ligne, gestion des employés, réservations clients, paiements intégrés. Tout ce dont votre entreprise a besoin, en un seul endroit.</p>
    <div class="hero-actions">
      <%= link_to "Essayer 14 jours gratuit", new_user_registration_path,
            class: "btn-white" %>
      <%= link_to "Trouver une entreprise", search_path,
            class: "btn-outline-white" %>
    </div>
  </div>
</section>

<section style="padding:64px 48px; max-width:1100px; margin:0 auto;">
  <div style="text-align:center; margin-bottom:48px;">
    <h2 style="font-family:var(--font-display); font-size:2rem; margin-bottom:12px;">
      Pourquoi Planify Pro ?
    </h2>
    <p style="color:var(--text-500); max-width:560px; margin:0 auto;">
      Une solution pensée pour les entreprises de services qui veulent gagner du temps et offrir une expérience client premium.
    </p>
  </div>

  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
    <% [
      ["📅", "Planning intelligent", "Gérez votre équipe et vos créneaux. L'assignation automatique optimise votre charge de travail."],
      ["🌐", "Réservations en ligne", "Vos clients réservent directement depuis votre fiche. Disponible 24h/24."],
      ["💳", "Paiements sécurisés", "Encaissez directement sur votre compte Stripe. Zéro friction, zéro retard."]
    ].each do |icon, title, desc| %>
      <div class="card" style="padding:28px; text-align:center;">
        <div style="font-size:2.5rem; margin-bottom:16px;"><%= icon %></div>
        <h3 style="font-family:var(--font-display); margin-bottom:10px;"><%= title %></h3>
        <p style="font-size:0.9rem; color:var(--text-500);"><%= desc %></p>
      </div>
    <% end %>
  </div>
</section>
%>
