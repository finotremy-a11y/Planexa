<% content_for :title, t("home.meta.title") %>
<% content_for :meta_description do %><%= t("home.meta.description") %><% end %>
<% content_for :canonical, root_url %>

<style>
  .hero {
    background: linear-gradient(135deg, #6f8f79 0%, #7f9b86 55%, #8ca795 100%);
    padding: 100px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.45;
    z-index: 0;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: transparent;
    z-index: 2;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 28px;
    border-radius: 18px;
    background: rgba(22, 38, 30, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.34);
    box-shadow: 0 16px 34px rgba(18, 32, 24, 0.3);
    backdrop-filter: blur(2px);
  }
  .hero-media-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }
  .hero-media-row {
    position: absolute;
    left: -12%;
    width: 124%;
    overflow: hidden;
    opacity: 0.62;
  }
  .hero-media-row.top { top: 14%; transform: rotate(-1.6deg); }
  .hero-media-row.bottom { top: 54%; transform: rotate(1.2deg); }
  .hero-media-track {
    display: flex;
    width: max-content;
    gap: 14px;
    animation: hero-scroll 44s linear infinite;
  }
  .hero-media-row.bottom .hero-media-track {
    animation-name: hero-scroll-reverse;
    animation-duration: 52s;
  }
  .hero-media-card {
    position: relative;
    width: 244px;
    height: 154px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 20px rgba(18, 32, 24, 0.24);
    flex: 0 0 auto;
  }
  .hero-media-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.12) brightness(1.03);
  }
  .hero-media-card span {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    color: white;
    padding: 3px 8px;
    border-radius: 99px;
    background: rgba(12, 22, 16, 0.55);
    letter-spacing: 0.01em;
  }
  .hero h1 { font-family: var(--font-display); font-size: 3.2rem; font-weight: 700; color: white; margin-bottom: 20px; line-height: 1.15; }
  .hero p { font-size: 1.1rem; color: rgba(255,255,255,0.95); margin-bottom: 36px; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-hero-primary { background: white; color: #2f4a3a; font-weight: 700; padding: 16px 32px; border-radius: var(--radius-md); font-size: 1rem; transition: var(--transition); text-decoration: none; display: inline-block; }
  .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.25); color: #2f4a3a; }
  .btn-hero-secondary { background: transparent; color: white; border: 2px solid rgba(255,255,255,0.5); padding: 14px 28px; border-radius: var(--radius-md); font-size: 1rem; transition: var(--transition); text-decoration: none; display: inline-block; }
  .btn-hero-secondary:hover { border-color: white; background: rgba(255,255,255,0.1); color: white; }

  @keyframes hero-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes hero-scroll-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  @media (max-width: 900px) {
    .hero { padding: 64px 24px; }
    .hero h1 { font-size: 2.2rem; }
    .hero-media-card { width: 190px; height: 120px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 48px 20px; }
    .hero h1 { font-size: 1.8rem; }
    .hero p { font-size: 0.95rem; }
    .hero-media-row.bottom { display: none; }
    .hero-media-row { opacity: 0.5; }
    .hero-media-card { width: 168px; height: 106px; }
  }
</style>

<section class="hero">
  <% hero_professions = [
    ["Coiffeur", "https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=500&q=80"],
    ["Infirmiere", "https://images.unsplash.com/photo-1584515933487-779824d29309?auto=format&fit=crop&w=500&q=80"],
    ["Plombier", "https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=500&q=80"],
    ["Electricien", "https://images.unsplash.com/photo-1621905251918-48416bd8575a?auto=format&fit=crop&w=500&q=80"],
    ["Boulanger", "https://images.unsplash.com/photo-1549931319-a545dcf3bc73?auto=format&fit=crop&w=500&q=80"],
    ["Coach", "https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=500&q=80"],
    ["Mecanicien", "https://images.unsplash.com/photo-1487754180451-c456f719a1fc?auto=format&fit=crop&w=500&q=80"],
    ["Architecte", "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=500&q=80"]
  ] %>

  <div class="hero-media-layer" aria-hidden="true">
    <div class="hero-media-row top">
      <div class="hero-media-track">
        <% (hero_professions + hero_professions).each do |label, image_url| %>
          <div class="hero-media-card">
            <img src="<%= image_url %>" alt="<%= label %>">
            <span><%= label %></span>
          </div>
        <% end %>
      </div>
    </div>
    <div class="hero-media-row bottom">
      <div class="hero-media-track">
        <% (hero_professions.reverse + hero_professions.reverse).each do |label, image_url| %>
          <div class="hero-media-card">
            <img src="<%= image_url %>" alt="<%= label %>">
            <span><%= label %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="hero-content">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.12);
                border:1px solid rgba(255,255,255,0.2); color:rgba(255,255,255,0.9);
                padding:6px 14px; border-radius:99px; font-size:0.82rem; margin-bottom:24px;">
      ⚙ <%= t("home.hero.badge") %>
    </div>
    <h1><%= t("home.hero.title_html") %></h1>
    <p>
      <%= t("home.hero.description") %>
    </p>
    <div class="hero-actions">
      <%= link_to t("home.hero.cta_trial"), new_user_registration_path, class: "btn-hero-primary" %>
      <%= link_to t("home.hero.cta_search"), search_path, class: "btn-hero-secondary" %>
    </div>
  </div>
</section>

<section class="home-section" style="padding:72px 48px; max-width:1100px; margin:0 auto;">
  <div style="text-align:center; margin-bottom:52px;">
    <h2 style="font-family:var(--font-display); font-size:2.2rem; margin-bottom:12px;">
      <%= t("home.features.heading") %>
    </h2>
    <p style="color:var(--text-500); max-width:560px; margin:0 auto; font-size:1rem;">
      <%= t("home.features.subheading") %>
    </p>
    <p style="color:var(--text-500); max-width:560px; margin:14px auto 0; font-size:1rem;">
      <%= t("home.features.made_in_france") %>
    </p>
  </div>

  <div class="responsive-3col-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
    <% [
      ["📅", t("home.features.items.planning.title"), t("home.features.items.planning.description")],
      ["🌐", t("home.features.items.booking.title"), t("home.features.items.booking.description")],
      ["💳", t("home.features.items.payment.title"), t("home.features.items.payment.description")],
      ["👥", t("home.features.items.team.title"), t("home.features.items.team.description")],
      ["🔔", t("home.features.items.reminders.title"), t("home.features.items.reminders.description")],
      ["📊", t("home.features.items.analytics.title"), t("home.features.items.analytics.description")]
    ].each do |icon, title, desc| %>
      <div class="card" style="padding:28px;">
        <div style="font-size:2rem; margin-bottom:14px;"><%= icon %></div>
        <h3 style="font-family:var(--font-display); font-size:1.1rem; margin-bottom:8px;"><%= title %></h3>
        <p style="font-size:0.88rem; color:var(--text-500); margin:0;"><%= desc %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="home-section" style="background:var(--green-900); padding:72px 48px; text-align:center;">
  <h2 style="font-family:var(--font-display); font-size:2rem; color:white; margin-bottom:12px;">
    <%= t("home.bottom_cta.heading") %>
  </h2>
  <p style="color:rgba(255,255,255,0.65); margin-bottom:32px; font-size:1rem;">
    <%= t("home.bottom_cta.subheading") %>
  </p>
  <%= link_to t("home.bottom_cta.button"), new_user_registration_path,
        style: "background:var(--gold-600); color:white; padding:16px 32px;
                border-radius:var(--radius-md); font-weight:700; font-size:1rem;
                text-decoration:none; display:inline-block; transition:var(--transition);" %>
</section>


<section class="home-section" style="background:var(--bg-secondary); border-top:1px solid var(--border); padding:52px 48px;">
  <div style="max-width:1100px; margin:0 auto;">
    <h2 style="font-family:var(--font-display); font-size:1.3rem; margin-bottom:6px;">
      Trouvez un professionnel près de chez vous
    </h2>
    <p style="color:var(--text-500); font-size:.88rem; margin-bottom:24px;">
      Réservez en ligne chez des milliers de professionnels dans votre ville.
    </p>

    <% [
      { label: "Coiffeur",        activity: "coiffeur",            cities: ["paris", "lyon", "marseille", "toulouse", "bordeaux", "nantes"] },
      { label: "Ostéopathe",      activity: "osteopathe",          cities: ["paris", "lyon", "marseille", "toulouse", "bordeaux", "montpellier"] },
      { label: "Kiné",            activity: "kinesitherapeute",    cities: ["paris", "lyon", "marseille", "toulouse", "nantes", "bordeaux"] },
      { label: "Médecin",         activity: "medecin-generaliste", cities: ["paris", "lyon", "marseille", "toulouse", "bordeaux", "lille"] },
      { label: "Coach sportif",   activity: "coach-sportif",       cities: ["paris", "lyon", "marseille", "bordeaux", "nantes", "strasbourg"] },
      { label: "Sophrologue",     activity: "sophrologue",         cities: ["paris", "lyon", "toulouse", "bordeaux", "nantes", "montpellier"] }
    ].each do |group| %>
      <div style="margin-bottom:18px;">
        <div style="font-weight:600; font-size:.82rem; text-transform:uppercase; letter-spacing:.06em;
                    color:var(--green-800); margin-bottom:8px;"><%= group[:label] %></div>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% group[:cities].each do |city| %>
            <%= link_to "#{group[:label]} #{city.capitalize}",
                  seo_search_landing_path(activity_slug: group[:activity], city_slug: city),
                  style: "font-size:.82rem; color:var(--text-600); background:white;
                          border:1px solid var(--border); border-radius:99px;
                          padding:4px 12px; text-decoration:none;
                          transition:var(--transition);" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
