<% content_for :title, "Planify Pro — Gestion de rendez-vous pour professionnels" %>
<% content_for :meta_description do %>Planify Pro — Gérez vos rendez-vous en ligne. Planning intelligent, réservations clients, gestion d'équipe. 14 jours d'essai gratuit pour les artisans et entreprises de services.<% end %>
<% content_for :canonical, root_url %>

<style>
  .hero {
    background: linear-gradient(135deg, var(--green-900) 0%, var(--green-800) 60%, var(--brown-700) 100%);
    padding: 100px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
  }
  .hero-content { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
  .hero h1 { font-family: var(--font-display); font-size: 3.2rem; font-weight: 700; color: white; margin-bottom: 20px; line-height: 1.15; }
  .hero p { font-size: 1.1rem; color: rgba(255,255,255,0.75); margin-bottom: 36px; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-hero-primary { background: white; color: var(--green-800); font-weight: 700; padding: 16px 32px; border-radius: var(--radius-md); font-size: 1rem; transition: var(--transition); text-decoration: none; display: inline-block; }
  .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.25); color: var(--green-800); }
  .btn-hero-secondary { background: transparent; color: white; border: 2px solid rgba(255,255,255,0.5); padding: 14px 28px; border-radius: var(--radius-md); font-size: 1rem; transition: var(--transition); text-decoration: none; display: inline-block; }
  .btn-hero-secondary:hover { border-color: white; background: rgba(255,255,255,0.1); color: white; }
</style>

<section class="hero">
  <div class="hero-content">
    <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.12);
                border:1px solid rgba(255,255,255,0.2); color:rgba(255,255,255,0.9);
                padding:6px 14px; border-radius:99px; font-size:0.82rem; margin-bottom:24px;">
      ⚙ Pour les artisans et professionnels de service
    </div>
    <h1>Gérez vos rendez-vous<br>comme un professionnel</h1>
    <p>
      Planning en ligne, gestion d'équipe, réservations clients et paiements intégrés.
      Tout ce dont votre entreprise a besoin, en un seul endroit.
    </p>
    <div class="hero-actions">
      <%= link_to "Essayer 14 jours gratuit", new_user_registration_path, class: "btn-hero-primary" %>
      <%= link_to "Trouver une entreprise", search_path, class: "btn-hero-secondary" %>
    </div>
  </div>
</section>

<section style="padding:72px 48px; max-width:1100px; margin:0 auto;">
  <div style="text-align:center; margin-bottom:52px;">
    <h2 style="font-family:var(--font-display); font-size:2.2rem; margin-bottom:12px;">
      Pourquoi choisir Planify Pro ?
    </h2>
    <p style="color:var(--text-500); max-width:560px; margin:0 auto; font-size:1rem;">
      Une solution pensée pour les artisans et entreprises de services qui veulent gagner en efficacité.
    </p>
  </div>

  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:28px;">
    <% [
      ["📅", "Planning intelligent", "Gérez votre équipe et vos créneaux. L'assignation automatique optimise votre charge de travail."],
      ["🌐", "Réservations en ligne", "Vos clients réservent directement depuis votre fiche, 24h/24."],
      ["💳", "Paiements sécurisés", "Encaissez directement sur votre compte Stripe. Zéro friction."],
      ["👥", "Gestion d'équipe", "Définissez les aptitudes et disponibilités de chaque employé."],
      ["🔔", "Rappels automatiques", "Vos clients reçoivent des rappels 24h avant leur RDV."],
      ["📊", "Suivi en temps réel", "Tableau de bord avec toutes vos statistiques et indicateurs."]
    ].each do |icon, title, desc| %>
      <div class="card" style="padding:28px;">
        <div style="font-size:2rem; margin-bottom:14px;"><%= icon %></div>
        <h3 style="font-family:var(--font-display); font-size:1.1rem; margin-bottom:8px;"><%= title %></h3>
        <p style="font-size:0.88rem; color:var(--text-500); margin:0;"><%= desc %></p>
      </div>
    <% end %>
  </div>
</section>

<section style="background:var(--green-900); padding:72px 48px; text-align:center;">
  <h2 style="font-family:var(--font-display); font-size:2rem; color:white; margin-bottom:12px;">
    Prêt à commencer ?
  </h2>
  <p style="color:rgba(255,255,255,0.65); margin-bottom:32px; font-size:1rem;">
    49 € / mois · 14 jours d'essai gratuit · Sans engagement
  </p>
  <%= link_to "Créer mon espace entreprise", new_user_registration_path,
        style: "background:var(--gold-600); color:white; padding:16px 32px;
                border-radius:var(--radius-md); font-weight:700; font-size:1rem;
                text-decoration:none; display:inline-block; transition:var(--transition);" %>
</section>

