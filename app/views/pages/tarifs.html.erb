<% content_for :title, "Tarifs — Planexa" %>
<% content_for :meta_description do %>Planexa : 49 €/mois pour prendre vos rendez-vous en ligne, réduire vos no-shows et fidéliser vos clients. Essayez 14 jours gratuitement.<% end %>

<%# ── Hero ─────────────────────────────────────────────────────────────────── %>
<div style="background:linear-gradient(135deg,#0f3a20,#1f6b3c); color:white; padding:64px 24px 48px; text-align:center;">
  <p style="text-transform:uppercase; letter-spacing:.1em; font-size:.75rem; opacity:.65; margin-bottom:12px;">Tarifs simples, sans surprise</p>
  <h1 style="font-family:var(--font-display); font-size:2.2rem; margin:0 0 14px 0;">
    Un seul tarif,<br>toutes les fonctionnalités incluses
  </h1>
  <p style="color:rgba(255,255,255,.78); max-width:540px; margin:0 auto 32px; line-height:1.7;">
    Pas de modules à la carte. Pas de frais cachés. Tout ce dont votre entreprise a besoin pour gérer ses rendez-vous, réduire les no-shows et fidéliser ses clients.
  </p>

  <%# ── Carte prix principale ── %>
  <div style="display:inline-block; background:white; color:var(--text-900); border-radius:var(--radius-lg);
              padding:36px 48px; box-shadow:0 16px 40px rgba(0,0,0,.2); text-align:center; min-width:280px;">
    <div style="font-size:.85rem; color:var(--text-400); margin-bottom:6px;">Abonnement mensuel</div>
    <div style="font-family:var(--font-display); font-size:3.2rem; font-weight:800; color:var(--green-800); line-height:1;">
      49 €
    </div>
    <div style="font-size:.78rem; color:var(--text-400); margin-bottom:20px;">HT / mois · sans engagement</div>
    <% if user_signed_in? %>
      <%= link_to "Accéder à mon espace →", company_root_path, class: "btn btn-primary",
            style: "width:100%; justify-content:center;" %>
    <% else %>
      <%= link_to "Démarrer 14 jours gratuits →", new_user_registration_path, class: "btn btn-primary",
            style: "width:100%; justify-content:center;" %>
    <% end %>
    <p style="font-size:.75rem; color:var(--text-400); margin-top:12px; margin-bottom:0;">
      Aucune carte bancaire requise pour l'essai
    </p>
  </div>
</div>

<%# ── ROI Estimateur ───────────────────────────────────────────────────────── %>
<div style="background:var(--green-50); border-bottom:1px solid var(--green-100); padding:40px 24px;">
  <div style="max-width:900px; margin:0 auto; text-align:center;">
    <h2 style="font-family:var(--font-display); margin-bottom:8px;">Planexa se rentabilise en quelques rendez-vous</h2>
    <p style="color:var(--text-500); margin-bottom:32px;">
      Un professionnel avec un panier moyen de 65 € et 3 no-shows évités par mois récupère
      <strong style="color:var(--green-800);">195 €</strong> — soit 4× l'abonnement.
    </p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px;">
      <div style="background:white; border-radius:var(--radius-lg); padding:24px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.06);">
        <div style="font-size:2rem; margin-bottom:6px;">📅</div>
        <div style="font-family:var(--font-display); font-size:1.6rem; color:var(--green-800);">+30 %</div>
        <div style="font-size:.82rem; color:var(--text-500);">de réservations via la page publique</div>
      </div>
      <div style="background:white; border-radius:var(--radius-lg); padding:24px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.06);">
        <div style="font-size:2rem; margin-bottom:6px;">🚫</div>
        <div style="font-family:var(--font-display); font-size:1.6rem; color:var(--green-800);">−60 %</div>
        <div style="font-size:.82rem; color:var(--text-500);">de no-shows avec rappels automatiques</div>
      </div>
      <div style="background:white; border-radius:var(--radius-lg); padding:24px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.06);">
        <div style="font-size:2rem; margin-bottom:6px;">⏱</div>
        <div style="font-family:var(--font-display); font-size:1.6rem; color:var(--green-800);">2 h</div>
        <div style="font-size:.82rem; color:var(--text-500);">économisées par semaine sur la gestion</div>
      </div>
      <div style="background:white; border-radius:var(--radius-lg); padding:24px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.06);">
        <div style="font-size:2rem; margin-bottom:6px;">💶</div>
        <div style="font-family:var(--font-display); font-size:1.6rem; color:var(--green-800);">49 €</div>
        <div style="font-size:.82rem; color:var(--text-500);">pour débloquer tout ça chaque mois</div>
      </div>
    </div>
  </div>
</div>

<%# ── Features incluses ────────────────────────────────────────────────────── %>
<div style="max-width:960px; margin:48px auto; padding:0 24px;">
  <h2 style="font-family:var(--font-display); text-align:center; margin-bottom:36px;">
    Tout est inclus, rien à configurer à la carte
  </h2>

  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:20px;">
    <% [
      { icon: "🌐", title: "Page de réservation publique", desc: "Votre vitrine professionnelle prête en 5 minutes. Partageable, indexable Google." },
      { icon: "📲", title: "Rappels automatiques", desc: "Email, SMS et push notification. Configurables par canal, par prestation, par délai." },
      { icon: "✅", title: "Reconfirmation 24h avant", desc: "Le client confirme sa présence. Vous visualisez les non-répondants à temps." },
      { icon: "💳", title: "Acompte et paiement en ligne", desc: "Réduisez drastiquement les no-shows en demandant un acompte dès la réservation." },
      { icon: "📊", title: "Dashboard ROI entreprise", desc: "Chiffre d'affaires, no-shows évités, panier moyen. Tout visualisé en quelques clics." },
      { icon: "⭐", title: "Avis clients automatiques", desc: "Demande d'avis envoyée après chaque RDV terminé. Publiable ou modérable." },
      { icon: "🎁", title: "Programme de fidélité", desc: "X rendez-vous = récompense. Paramétrable et visible par vos clients." },
      { icon: "📋", title: "Liste d'attente automatique", desc: "Un créneau s'annule ? La liste d'attente est notifiée immédiatement." },
      { icon: "🩺", title: "Mode professionnel de santé", desc: "Spécialités, secteur de conventionnement, créneaux dédiés. Pour médecins et para-médicaux." },
      { icon: "🔌", title: "API & Webhooks", desc: "Connectez Planexa à vos outils métier. Documentation complète fournie." },
      { icon: "📱", title: "Application mobile (PWA)", desc: "Installable sur iOS et Android. Notifications push natives." },
      { icon: "🔒", title: "Sécurité et conformité RGPD", desc: "Données hébergées en Europe, chiffrement, audit d'accès, politique d'effacement." }
    ].each do |feat| %>
      <div style="display:flex; align-items:flex-start; gap:14px;">
        <div style="font-size:1.4rem; flex-shrink:0; margin-top:2px;"><%= feat[:icon] %></div>
        <div>
          <div style="font-weight:600; margin-bottom:4px;"><%= feat[:title] %></div>
          <div style="font-size:.83rem; color:var(--text-500); line-height:1.6;"><%= feat[:desc] %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# ── Objections ───────────────────────────────────────────────────────────── %>
<div style="background:var(--bg-secondary); border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:48px 24px;">
  <div style="max-width:800px; margin:0 auto;">
    <h2 style="font-family:var(--font-display); text-align:center; margin-bottom:32px;">Questions fréquentes</h2>
    <div style="display:flex; flex-direction:column; gap:20px;">
      <% [
        { q: "Y a-t-il un engagement minimum ?",
          r: "Non. Vous pouvez résilier à tout moment depuis votre espace, sans frais. La résiliation prend effet à la fin de la période facturée." },
        { q: "Que se passe-t-il après les 14 jours d'essai ?",
          r: "Vous choisissez de passer à l'abonnement payant (49 €/mois) ou non. Aucun prélèvement automatique sans votre accord explicite." },
        { q: "Les clients payent-ils pour prendre RDV ?",
          r: "Non. La prise de RDV est entièrement gratuite pour vos clients. L'abonnement concerne uniquement l'entreprise." },
        { q: "Est-ce compatible avec mon activité médicale ?",
          r: "Oui. Planexa propose un mode professionnel de santé adapté : spécialités, secteur de conventionnement, créneaux urgents, conformité RGPD renforcée." },
        { q: "Puis-je migrer mes données si je résilie ?",
          r: "Oui. Export CSV de vos rendez-vous, clients et prestations disponible depuis votre dashboard à tout moment." }
      ].each do |item| %>
        <details style="border:1px solid var(--border); border-radius:var(--radius-md); padding:0; overflow:hidden;">
          <summary style="padding:16px 20px; font-weight:600; cursor:pointer; list-style:none;
                          display:flex; justify-content:space-between; align-items:center;">
            <%= item[:q] %>
            <span style="color:var(--text-400); font-size:.9rem;">▾</span>
          </summary>
          <div style="padding:0 20px 16px; color:var(--text-600); font-size:.9rem; line-height:1.7;">
            <%= item[:r] %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</div>

<%# ── CTA final ────────────────────────────────────────────────────────────── %>
<div style="padding:64px 24px; text-align:center;">
  <h2 style="font-family:var(--font-display); margin-bottom:10px;">Prêt à démarrer ?</h2>
  <p style="color:var(--text-500); margin-bottom:28px; max-width:460px; margin-left:auto; margin-right:auto;">
    Créez votre compte, configurez votre première prestation et recevez votre premier rendez-vous en ligne — en moins de 10 minutes.
  </p>
  <% if user_signed_in? %>
    <%= link_to "Accéder à mon espace →", company_root_path, class: "btn btn-primary btn-lg" %>
  <% else %>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <%= link_to "Démarrer gratuitement →", new_user_registration_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Voir la démo", search_path, class: "btn btn-secondary btn-lg" %>
    </div>
  <% end %>
  <p style="font-size:.78rem; color:var(--text-400); margin-top:16px;">
    14 jours d'essai · Aucune carte bancaire · Résiliation en 1 clic
  </p>
</div>
