<% content_for :title, t("payment.title") %>

<div style="max-width:520px; margin:48px auto; padding:0 24px;"
  data-controller="stripe-payment"
  data-stripe-payment-publishable-key-value="<%= @publishable_key %>"
  data-stripe-payment-client-secret-value="<%= @payment_intent.client_secret %>"
  data-stripe-payment-return-url-value="<%= confirmation_appointments_url(appointment_id: @appointment.id) %>"
  data-stripe-payment-processing-text-value="<%= t("payment.processing") %>"
  data-stripe-payment-retry-text-value="<%= t("payment.retry_button") %>">
  <h1 style="font-family:var(--font-display); margin-bottom:8px;"><%= t("payment.title") %></h1>
  <p style="color:var(--text-500); margin-bottom:32px;">
    <%= @appointment.service_type.name %> — <%= @appointment.company.name %>
  </p>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-body">
      <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
        <span style="color:var(--text-500);"><%= t("payment.service_label") %></span>
        <strong><%= @appointment.service_type.name %></strong>
      </div>
      <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
        <span style="color:var(--text-500);"><%= t("payment.date_label") %></span>
        <strong><%= @appointment.scheduled_at.strftime("%d/%m/%Y à %Hh%M") %></strong>
      </div>
      <div style="border-top:1px solid var(--border-light); padding-top:12px; margin-top:4px;
                  display:flex; justify-content:space-between;">
        <span style="font-weight:600;"><%= @appointment.service_type.deposit_required? ? "Acompte a payer" : t("payment.total_label") %></span>
        <strong style="font-size:1.2rem; color:var(--green-800);">
          <%= number_to_currency(@appointment.payment_amount_cents / 100.0,
                unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
        </strong>
      </div>

      <% if @appointment.service_type.deposit_required? %>
        <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:0.86rem; color:var(--text-500);">
          <span>Reste a regler sur place</span>
          <strong>
            <%= number_to_currency((@appointment.service_type.price_cents - @appointment.payment_amount_cents) / 100.0,
                  unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
          </strong>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div id="payment-element" style="margin-bottom:20px;" data-stripe-payment-target="paymentElement"></div>
      <div id="payment-errors" class="alert alert-error" style="display:none; margin-bottom:16px;" data-stripe-payment-target="errors"></div>
      <button id="submit-payment" class="btn btn-primary btn-lg" style="width:100%; justify-content:center;"
          data-stripe-payment-target="submit"
          data-action="click->stripe-payment#submit">
          <%= t("payment.pay_button", amount: number_to_currency(@appointment.payment_amount_cents / 100.0,
            unit: "€", separator: ",", delimiter: " ", format: "%n %u")) %>
      </button>
      <p style="font-size:0.75rem; color:var(--text-300); text-align:center; margin-top:12px;">
          🔒 <%= t("payment.stripe_notice") %>
      </p>
    </div>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
