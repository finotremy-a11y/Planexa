<% content_for :title, @company.name %>
<% content_for :page_title, "Entreprise — #{@company.name}" %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
  <div>
    <h1 style="font-family:var(--font-display); font-size:1.6rem; color:#0f172a; margin-bottom:4px;">
      <%= @company.name %>
    </h1>
    <div style="font-size:0.85rem; color:#64748b;">
      📍 <%= @company.address %>, <%= @company.zip_code %> <%= @company.city %>
    </div>
  </div>
  <div style="display:flex; gap:10px;">
    <% if @company.active? %>
      <%= button_to "Suspendre",
            suspend_admin_company_path(@company),
            method: :patch,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: "Suspendre ce compte ?" } %>
    <% else %>
      <%= button_to "Réactiver",
            reactivate_admin_company_path(@company),
            method: :patch,
            class: "btn btn-primary btn-sm" %>
    <% end %>
    <%= link_to "← Retour", admin_companies_path, class: "btn btn-ghost btn-sm" %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:24px;">
  <div class="admin-stat">
    <div class="admin-stat-value"><%= @company.employees.count %></div>
    <div class="admin-stat-label">Employés</div>
  </div>
  <div class="admin-stat">
    <div class="admin-stat-value"><%= @company.appointments.count %></div>
    <div class="admin-stat-label">Rendez-vous total</div>
  </div>
  <div class="admin-stat">
    <div class="admin-stat-value"><%= @company.service_types.count %></div>
    <div class="admin-stat-label">Prestations</div>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
  <div class="admin-table-wrapper">
    <div class="admin-table-header"><h3>Informations</h3></div>
    <div style="padding:16px 20px; display:flex; flex-direction:column; gap:12px;">
      <% [
        ["SIRET", @company.siret],
        ["Email", @company.user.email],
        ["Téléphone", @company.phone.presence || "—"],
        ["Site web", @company.website.presence || "—"],
        ["Inscription", @company.created_at.strftime("%d/%m/%Y")],
        ["Statut", @company.status.humanize]
      ].each do |label, value| %>
        <div style="display:flex; justify-content:space-between; font-size:0.88rem;">
          <span style="color:#64748b; font-weight:500;"><%= label %></span>
          <span style="color:#1e293b;"><%= value %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="admin-table-wrapper">
    <div class="admin-table-header"><h3>Abonnement</h3></div>
    <div style="padding:16px 20px;">
      <% if @subscription %>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <% [
            ["Statut", @subscription.status.humanize],
            ["Stripe ID", @subscription.stripe_subscription_id],
            ["Fin période", @subscription.current_period_end&.strftime("%d/%m/%Y") || "—"],
            ["Fin essai", @subscription.trial_ends_at&.strftime("%d/%m/%Y") || "—"]
          ].each do |label, value| %>
            <div style="display:flex; justify-content:space-between; font-size:0.88rem;">
              <span style="color:#64748b; font-weight:500;"><%= label %></span>
              <span style="color:#1e293b; font-family:<%= label == 'Stripe ID' ? 'monospace' : 'inherit' %>;
                           font-size:<%= label == 'Stripe ID' ? '0.75rem' : 'inherit' %>;">
                <%= value %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color:#94a3b8; font-size:0.85rem;">Aucun abonnement.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="admin-table-wrapper" style="margin-top:20px;">
  <div class="admin-table-header">
    <h3>Derniers rendez-vous</h3>
  </div>
  <% if @appointments.any? %>
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="background:#f8fafc;">
          <% ["Date", "Prestation", "Client", "Employé", "Statut"].each do |header| %>
            <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                       font-weight:600; text-transform:uppercase;
                       color:#94a3b8; border-bottom:1px solid #e2e8f0;">
              <%= header %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appointment| %>
          <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 16px; font-size:0.82rem;">
              <%= appointment.scheduled_at.strftime("%d/%m/%Y %Hh%M") %>
            </td>
            <td style="padding:10px 16px; font-size:0.82rem;">
              <%= appointment.service_type.name %>
            </td>
            <td style="padding:10px 16px; font-size:0.82rem; color:#64748b;">
              <%= appointment.client_user&.full_name || "—" %>
            </td>
            <td style="padding:10px 16px; font-size:0.82rem; color:#64748b;">
              <%= appointment.employee&.full_name || "—" %>
            </td>
            <td style="padding:10px 16px;">
              <% colors = {
                "confirmed" => "#dcfce7,#16a34a",
                "pending" => "#fef9c3,#a16207",
                "cancelled" => "#fee2e2,#dc2626",
                "completed" => "#f1f5f9,#64748b"
              }
              bg, fg = (colors[appointment.status] || "#f1f5f9,#64748b").split(',') %>
              <span style="font-size:0.72rem; font-weight:500; padding:2px 7px;
                           border-radius:99px; background:<%= bg %>; color:<%= fg %>;">
                <%= appointment.status.humanize %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="padding:20px; color:#94a3b8; font-size:0.85rem;">Aucun rendez-vous.</p>
  <% end %>
</div>
