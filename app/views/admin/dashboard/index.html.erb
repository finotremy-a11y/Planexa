<% content_for :title, "Dashboard Admin" %>
<% content_for :page_title, "Dashboard" %>

<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px;">
  <div class="admin-stat" style="border-top:3px solid #2C5F2E;">
    <div class="admin-stat-value"><%= @total_companies %></div>
    <div class="admin-stat-label">Entreprises totales</div>
    <div class="admin-stat-trend up">+<%= @new_companies_30d %> ce mois</div>
  </div>

  <div class="admin-stat" style="border-top:3px solid #B8860B;">
    <div class="admin-stat-value"><%= @active_subs %></div>
    <div class="admin-stat-label">Abonnements actifs</div>
    <div class="admin-stat-trend up"><%= @trialing_subs %> en essai</div>
  </div>

  <div class="admin-stat" style="border-top:3px solid #6366f1;">
    <div class="admin-stat-value"><%= @total_clients %></div>
    <div class="admin-stat-label">Clients inscrits</div>
    <div class="admin-stat-trend up">+<%= @new_clients_30d %> ce mois</div>
  </div>

  <div class="admin-stat" style="border-top:3px solid #0ea5e9;">
    <div class="admin-stat-value"><%= number_to_currency(@mrr, unit:"€", separator:",", delimiter:" ", format:"%n %u") %></div>
    <div class="admin-stat-label">MRR estimé</div>
    <div class="admin-stat-trend">
      <%= @past_due_subs.positive? ? "⚠️ #{@past_due_subs} impayé(s)" : "✓ Tout à jour" %>
    </div>
  </div>
</div>

<div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:24px;">
  <% [
    ["Actifs",    @active_subs,    "#16a34a"],
    ["Essai",     @trialing_subs,  "#B8860B"],
    ["Impayés",   @past_due_subs,  "#dc2626"],
    ["Suspendus", @suspended_companies, "#f97316"],
    ["Annulés",   @canceled_subs,  "#94a3b8"]
  ].each do |label, count, color| %>
    <div style="background:white; border-radius:8px; padding:14px 16px;
                border:1px solid #e2e8f0; border-left:4px solid <%= color %>;">
      <div style="font-size:1.4rem; font-weight:700; color:#0f172a;"><%= count %></div>
      <div style="font-size:0.75rem; color:#64748b;"><%= label %></div>
    </div>
  <% end %>
</div>

<div style="display:grid; grid-template-columns:1fr 380px; gap:20px;">
  <div class="admin-table-wrapper">
    <div class="admin-table-header">
      <h3>Dernières entreprises inscrites</h3>
      <%= link_to "Voir tout →", admin_companies_path,
            style: "font-size:0.82rem; color:#2C5F2E;" %>
    </div>
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="background:#f8fafc;">
          <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                     font-weight:600; text-transform:uppercase; letter-spacing:0.05em;
                     color:#94a3b8; border-bottom:1px solid #e2e8f0;">Entreprise</th>
          <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                     font-weight:600; text-transform:uppercase; letter-spacing:0.05em;
                     color:#94a3b8; border-bottom:1px solid #e2e8f0;">Statut</th>
          <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                     font-weight:600; text-transform:uppercase; letter-spacing:0.05em;
                     color:#94a3b8; border-bottom:1px solid #e2e8f0;">Abonnement</th>
          <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                     font-weight:600; text-transform:uppercase; letter-spacing:0.05em;
                     color:#94a3b8; border-bottom:1px solid #e2e8f0;">Inscrit le</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_companies.each do |company| %>
          <tr style="border-bottom:1px solid #f1f5f9;"
              onmouseenter="this.style.background='#f8fafc'"
              onmouseleave="this.style.background='white'">
            <td style="padding:12px 16px;">
              <div style="font-weight:500; font-size:0.88rem;">
                <%= link_to company.name, admin_company_path(company),
                      style: "color:#1e293b; text-decoration:none;" %>
              </div>
              <div style="font-size:0.75rem; color:#94a3b8;"><%= company.city %></div>
            </td>
            <td style="padding:12px 16px;">
              <span style="font-size:0.75rem; font-weight:500; padding:3px 8px;
                           border-radius:99px;
                           background:<%= company.active? ? '#dcfce7' : '#fee2e2' %>;
                           color:<%= company.active? ? '#16a34a' : '#dc2626' %>;">
                <%= company.active? ? "Actif" : company.status.humanize %>
              </span>
            </td>
            <td style="padding:12px 16px;">
              <% if company.subscription %>
                <span style="font-size:0.75rem; color:#64748b;">
                  <%= company.subscription.status.humanize %>
                </span>
              <% else %>
                <span style="font-size:0.75rem; color:#cbd5e1;">Aucun</span>
              <% end %>
            </td>
            <td style="padding:12px 16px; font-size:0.82rem; color:#64748b;">
              <%= company.created_at.strftime("%d/%m/%Y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="admin-table-wrapper">
    <div class="admin-table-header">
      <h3>⚠️ Impayés</h3>
      <span style="font-size:0.78rem; color:#dc2626; font-weight:600;">
        <%= @overdue_subscriptions.count %> compte(s)
      </span>
    </div>
    <% if @overdue_subscriptions.any? %>
      <div style="padding:8px 0;">
        <% @overdue_subscriptions.each do |subscription| %>
          <div style="padding:12px 16px; border-bottom:1px solid #f1f5f9;
                      display:flex; justify-content:space-between; align-items:center;">
            <div>
              <div style="font-weight:500; font-size:0.88rem;">
                <%= subscription.company.name %>
              </div>
              <div style="font-size:0.75rem; color:#94a3b8;">
                Depuis <%= subscription.current_period_end&.strftime("%d/%m") %>
              </div>
            </div>
            <%= link_to "Voir →", admin_company_path(subscription.company),
                  style: "font-size:0.78rem; color:#2C5F2E;" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="padding:32px; text-align:center; color:#94a3b8; font-size:0.85rem;">
        ✅ Aucun impayé
      </div>
    <% end %>
  </div>
</div>
