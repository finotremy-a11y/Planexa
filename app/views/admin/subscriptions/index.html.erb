<% content_for :title, t("admin.subscriptions_title") %>
<% content_for :page_title, t("admin.subscriptions_title") %>

<div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:20px;">
  <% [
    [t("admin.status_active"), @counts[:active], "#16a34a"],
    [t("admin.status_trialing"), @counts[:trialing], "#B8860B"],
    [t("admin.status_overdue"), @counts[:past_due], "#dc2626"],
    [t("admin.status_suspended"), @counts[:suspended], "#f97316"],
    [t("admin.status_canceled"), @counts[:canceled], "#94a3b8"]
  ].each do |label, count, color| %>
    <div style="background:white; border-radius:8px; padding:14px 16px;
                border:1px solid #e2e8f0; border-left:4px solid <%= color %>;">
      <div style="font-size:1.4rem; font-weight:700; color:#0f172a;"><%= count %></div>
      <div style="font-size:0.75rem; color:#64748b;"><%= label %></div>
    </div>
  <% end %>
</div>

<div class="admin-table-wrapper">
  <div class="admin-table-header">
    <h3><%= t("admin.subscription_count", count: @pagy.count) %></h3>
  </div>
  <table style="width:100%; border-collapse:collapse;">
    <thead>
      <tr style="background:#f8fafc;">
        <% [t("admin.company_header"), t("admin.status_header"), "Stripe ID", t("admin.period_end"), t("admin.actions_header")].each do |header| %>
          <th style="padding:10px 16px; text-align:left; font-size:0.72rem;
                     font-weight:600; text-transform:uppercase;
                     color:#94a3b8; border-bottom:1px solid #e2e8f0;">
            <%= header %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @subscriptions.each do |subscription| %>
        <tr style="border-bottom:1px solid #f1f5f9;"
            onmouseenter="this.style.background='#f8fafc'"
            onmouseleave="this.style.background='white'">
          <td style="padding:12px 16px;">
            <div style="font-weight:500; font-size:0.88rem;">
              <%= link_to subscription.company.name, admin_company_path(subscription.company),
                    style: "color:#1e293b; text-decoration:none;" %>
            </div>
          </td>
          <td style="padding:12px 16px;">
            <% colors = {
              "active" => "#dcfce7,#16a34a",
              "trialing" => "#fef9c3,#a16207",
              "past_due" => "#fee2e2,#dc2626",
              "suspended" => "#fee2e2,#dc2626",
              "canceled" => "#f1f5f9,#94a3b8"
            }
            bg, fg = (colors[subscription.status] || "#f1f5f9,#64748b").split(",") %>
            <span style="font-size:0.75rem; font-weight:500; padding:3px 8px;
                         border-radius:99px; background:<%= bg %>; color:<%= fg %>;">
              <%= t("statuses.#{subscription.status}", default: subscription.status.humanize) %>
            </span>
          </td>
          <td style="padding:12px 16px; font-family:monospace; font-size:0.75rem; color:#94a3b8;">
            <%= subscription.stripe_subscription_id %>
          </td>
          <td style="padding:12px 16px; font-size:0.82rem; color:#64748b;">
            <%= subscription.current_period_end&.strftime("%d/%m/%Y") || "-" %>
          </td>
          <td style="padding:12px 16px;">
            <%= link_to t("common.view"), admin_subscription_path(subscription),
                  style: "font-size:0.78rem; color:#2C5F2E; font-weight:500;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div style="padding:16px 20px; border-top:1px solid #e2e8f0;">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
