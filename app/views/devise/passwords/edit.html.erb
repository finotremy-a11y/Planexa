<% content_for :title, "Nouveau mot de passe" %>

<div class="auth-form-header">
  <h1>Nouveau mot de passe</h1>
  <p>Choisissez un mot de passe sécurisé d'au moins 8 caractères.</p>
</div>

<%= form_for(resource, as: resource_name,
      url: password_path(resource_name), html: { method: :put }) do |f| %>
  <% if resource.errors.any? %>
    <div class="alert alert-error" style="margin-bottom:20px;">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= f.hidden_field :reset_password_token %>

  <div class="form-group">
    <%= f.label :password, "Nouveau mot de passe", class: "form-label" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
          class: "form-control", placeholder: "8 caractères minimum" %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "form-control", placeholder: "••••••••" %>
  </div>

  <%= f.submit "Changer mon mot de passe →", class: "btn btn-primary btn-lg",
        style: "width:100%; justify-content:center;" %>
<% end %>
