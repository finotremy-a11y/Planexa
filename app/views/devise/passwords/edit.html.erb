<% content_for :title, t("auth.new_password") %>

<div class="auth-form-header">
  <h1><%= t("auth.new_password") %></h1>
  <p><%= t("auth.new_password_description") %></p>
</div>

<%= form_for(resource, as: resource_name,
      url: password_path(resource_name), html: { method: :put }) do |f| %>
  <% if resource.errors.any? %>
    <div class="alert alert-error" style="margin-bottom:20px;">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= f.hidden_field :reset_password_token %>

  <div class="form-group">
    <%= f.label :password, t("auth.new_password"), class: "form-label" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
          class: "form-control", placeholder: t("auth.password_minimum") %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, t("auth.password_confirmation"), class: "form-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "form-control", placeholder: t("auth.password_placeholder") %>
  </div>

  <%= f.submit t("auth.change_password"), class: "btn btn-primary btn-lg",
        style: "width:100%; justify-content:center;" %>
<% end %>
