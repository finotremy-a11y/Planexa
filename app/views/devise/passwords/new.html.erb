<% content_for :title, "Mot de passe oublié" %>

<div class="auth-form-header">
  <h1>Mot de passe oublié ?</h1>
  <p>Entrez votre email et nous vous enverrons un lien de réinitialisation.</p>
</div>

<%= form_for(resource, as: resource_name,
      url: password_path(resource_name), html: { method: :post }) do |f| %>
  <% if resource.errors.any? %>
    <div class="alert alert-error" style="margin-bottom:20px;">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :email, "Adresse email", class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "form-control", placeholder: "vous@exemple.fr" %>
  </div>

  <%= f.submit "Envoyer le lien →", class: "btn btn-primary btn-lg",
        style: "width:100%; justify-content:center;" %>
<% end %>

<div style="text-align:center; margin-top:20px;">
  <%= link_to "← Retour à la connexion", new_user_session_path,
        style: "font-size:0.85rem; color:var(--text-500);" %>
</div>
