<% content_for :title, t("auth.forgot_password") %>

<div class="auth-form-header">
  <h1><%= t("auth.forgot_password_title") %></h1>
  <p><%= t("auth.reset_password_description") %></p>
</div>

<%= form_for(resource, as: resource_name,
      url: password_path(resource_name), html: { method: :post }) do |f| %>
  <% if resource.errors.any? %>
    <div class="alert alert-error" style="margin-bottom:20px;">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :email, t("auth.email"), class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "form-control", placeholder: t("auth.email_placeholder") %>
  </div>

  <%= f.submit t("auth.send_reset_link"), class: "btn btn-primary btn-lg",
        style: "width:100%; justify-content:center;" %>
<% end %>

<div style="text-align:center; margin-top:20px;">
  <%= link_to t("auth.back_to_sign_in"), new_user_session_path,
        style: "font-size:0.85rem; color:var(--text-500);" %>
</div>
