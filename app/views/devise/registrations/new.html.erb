<% content_for :title, t("auth.create_account") %>

<div class="auth-form-header">
  <h1><%= t("auth.create_your_account") %></h1>
  <p><%= t("auth.already_registered") %> <%= link_to t("auth.sign_in"), new_user_session_path %></p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% if resource.errors.any? %>
    <div class="alert alert-error" style="margin-bottom:20px;">
      <% resource.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <div class="form-label" style="margin-bottom:10px;"><%= t("auth.i_am") %></div>
    <div class="responsive-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:10px;"
         data-controller="role-selector">
      <label style="display:flex; align-items:center; gap:10px; padding:12px 16px;
                     border:2px solid var(--border); border-radius:var(--radius-md);
                     cursor:pointer; transition:var(--transition);"
             id="label-client"
             data-role-selector-target="clientLabel">
        <%= f.radio_button :role, "client", checked: resource.role.blank? || resource.role == "client",
              style: "accent-color:var(--green-800);",
              data: { role_selector_target: "radio", action: "change->role-selector#refresh" } %>
        <div>
          <div style="font-weight:600; font-size:0.9rem;"><%= t("auth.client") %></div>
          <div style="font-size:0.75rem; color:var(--text-500);"><%= t("auth.free") %></div>
        </div>
      </label>
      <label style="display:flex; align-items:center; gap:10px; padding:12px 16px;
                     border:2px solid var(--border); border-radius:var(--radius-md);
                     cursor:pointer; transition:var(--transition);"
         id="label-company"
         data-role-selector-target="companyLabel">
        <%= f.radio_button :role, "company_admin",
              checked: resource.role == "company_admin",
          style: "accent-color:var(--green-800);",
          data: { role_selector_target: "radio", action: "change->role-selector#refresh" } %>
        <div>
          <div style="font-weight:600; font-size:0.9rem;"><%= t("auth.company") %></div>
          <div style="font-size:0.75rem; color:var(--gold-600);"><%= t("auth.trial_14_days") %></div>
        </div>
      </label>
    </div>
  </div>

  <div class="responsive-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
    <div class="form-group">
      <%= f.label :first_name, t("auth.first_name"), class: "form-label" %>
      <%= f.text_field :first_name, class: "form-control", placeholder: t("auth.first_name_placeholder"), autocomplete: "given-name" %>
    </div>
    <div class="form-group">
      <%= f.label :last_name, t("auth.last_name"), class: "form-label" %>
      <%= f.text_field :last_name, class: "form-control", placeholder: t("auth.last_name_placeholder"), autocomplete: "family-name" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :email, t("auth.email"), class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "form-control", placeholder: t("auth.email_placeholder") %>
  </div>

  <div class="form-group">
    <%= f.label :locale, t("locales.language"), class: "form-label" %>
    <%= f.select :locale,
          LocaleSwitcher::SUPPORTED_LOCALES.map { |code| [locale_name(code), code] },
          { selected: I18n.locale.to_s },
          class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :password, t("auth.password"), class: "form-label" %>
    <%= f.password_field :password, autocomplete: "new-password",
          class: "form-control", placeholder: t("auth.password_minimum") %>
    <span class="form-hint"><%= t("auth.password_minimum") %></span>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, t("auth.password_confirmation"), class: "form-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "form-control", placeholder: t("auth.password_placeholder") %>
  </div>

  <div style="font-size:0.78rem; color:var(--text-300); margin-bottom:16px; line-height:1.6;">
    <%= t("auth.accept_terms_html", terms: link_to(t("footer.terms_of_use"), cgu_path, style: "color:var(--green-700);"), privacy: link_to(t("footer.privacy"), confidentialite_path, style: "color:var(--green-700);")) %>
  </div>

  <%= f.submit t("auth.create_account_cta"), class: "btn btn-primary btn-lg",
        style: "width:100%; justify-content:center;" %>
<% end %>
