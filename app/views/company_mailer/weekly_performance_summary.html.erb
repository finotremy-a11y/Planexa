<div style="font-family:Arial, sans-serif; line-height:1.6; color:#1f2937;">
  <h1 style="font-size:20px; margin:0 0 8px 0;"><%= t("mailers.company.weekly_performance_summary.heading", company: @company.name) %></h1>
  <p style="margin:0 0 16px 0; color:#4b5563;">
    <%= t("mailers.company.weekly_performance_summary.period", from: @period_start.strftime("%d/%m/%Y"), to: @period_end.strftime("%d/%m/%Y")) %>
  </p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; border-collapse:separate; border-spacing:0 8px; margin-bottom:16px;">
    <tr>
      <td style="background:#ecfdf5; padding:12px 14px; border-radius:8px;">
        <strong><%= t("mailers.company.weekly_performance_summary.metrics.bookings") %></strong><br>
        <span style="font-size:18px;"><%= @weekly_bookings %></span>
      </td>
    </tr>
    <tr>
      <td style="background:#fffbeb; padding:12px 14px; border-radius:8px;">
        <strong><%= t("mailers.company.weekly_performance_summary.metrics.cancellations") %></strong><br>
        <span style="font-size:18px;"><%= @weekly_cancellations %></span>
      </td>
    </tr>
    <tr>
      <td style="background:#eff6ff; padding:12px 14px; border-radius:8px;">
        <strong><%= t("mailers.company.weekly_performance_summary.metrics.reviews") %></strong><br>
        <span style="font-size:18px;"><%= @weekly_reviews %></span>
      </td>
    </tr>
    <tr>
      <td style="background:#f5f3ff; padding:12px 14px; border-radius:8px;">
        <strong><%= t("mailers.company.weekly_performance_summary.metrics.estimated_revenue") %></strong><br>
        <span style="font-size:18px;"><%= number_to_currency(@weekly_estimated_revenue_eur, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
      </td>
    </tr>
  </table>

  <p style="margin:0 0 16px 0; color:#4b5563; font-size:14px;">
    <%= t("mailers.company.weekly_performance_summary.formula") %>
  </p>

  <p style="margin:0;">
    <%= link_to t("mailers.company.weekly_performance_summary.cta"), company_root_url,
          style: "display:inline-block; background:#166534; color:white; text-decoration:none; padding:10px 14px; border-radius:8px; font-weight:600;" %>
  </p>
</div>
